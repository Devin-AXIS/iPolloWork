{
  "schemaVersion": 2,
  "id": "plugin-workshop",
  "name": "插件工坊",
  "description": "在原生会话中制作、检查和打包 iPolloWork 插件，通过原生插件管理器安装与验证。",
  "category": "开发工具",
  "icon": {
    "src": "/ext-plugin-workshop.svg"
  },
  "source": {
    "format": "ipollowork-extension-manifest",
    "origin": "local",
    "trusted": false
  },
  "package": {
    "version": "0.1.1",
    "publisher": {
      "id": "ipollowork",
      "name": "iPolloWork"
    },
    "compatibility": {
      "ipollowork": ">=0.50.18"
    },
    "updateId": "ipollowork/plugin-workshop"
  },
  "resources": [
    {
      "type": "skill",
      "id": "plugin-workshop",
      "label": "插件制作",
      "path": "skills/plugin-workshop/SKILL.md",
      "required": true
    }
  ],
  "contributions": [
    {
      "type": "session-side-panel",
      "ref": "plugin-workshop",
      "label": "插件工坊",
      "location": "session-right-pane"
    }
  ],
  "localization": {
    "defaultLocale": "zh",
    "translations": {
      "en": {
        "name": "Plugin Workshop",
        "description": "Author, check and package iPolloWork plugins in conversation, then install and verify them with the native Plugin Manager.",
        "category": "Developer Tools",
        "resources": {
          "plugin-workshop": {
            "label": "Plugin authoring"
          }
        }
      }
    }
  }
}
