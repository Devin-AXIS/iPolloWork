{
  "name": "@ipollo/dsh-workspace-canvas",
  "version": "0.1.6",
  "description": "A minimal MCP App canvas that can be edited by people and agents.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": "0.2.3-alpha.2"
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "business",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE.md",
    "icon.svg",
    "NOTICE.dependencies.txt",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "node ../../integrations/tooling/ported-plugins.mjs build workspace-canvas",
    "check": "node ../../integrations/tooling/ported-plugins.mjs check workspace-canvas",
    "pack:check": "npm pack --dry-run"
  },
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.3-alpha.2"
  }
}
