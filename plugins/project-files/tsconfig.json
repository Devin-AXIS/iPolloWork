{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "react"],
    "paths": {
      "lucide-react": ["./node_modules/lucide-react/dist/lucide-react.d.ts"],
      "react": ["./node_modules/@types/react/index.js"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.js"],
      "@deepseek-ai/dsh-client-ui-primitives": ["../../.upstream/dsh/packages/client/ui-primitives/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-util-workspace-path": ["../../.upstream/dsh/packages/util/workspace-path/src/index.ts"]
    }
  },
  "include": ["src", "tests"]
}
