{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx", "allowImportingTsExtensions": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true, "types": ["node"],
    "paths": {
      "lucide-react": ["./node_modules/lucide-react/dist/lucide-react.d.ts"],
      "react": ["./node_modules/@types/react/index.js"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.js"],
      "@deepseek-ai/dsh-client-ui-primitives": ["./node_modules/@deepseek-ai/dsh-client-ui-primitives/lib/types/index.d.ts"]
    }
  },
  "include": ["src", "tests"]
}
