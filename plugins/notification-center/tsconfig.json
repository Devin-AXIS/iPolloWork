{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "react"],
    "paths": {
      "@deepseek-ai/cordis": [
        "../../.upstream/dsh/vendor/cordis/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-settings": [
        "../../.upstream/dsh/packages/settings/settings/lib/types/index.d.ts"
      ],
      "@deepseek-ai/schemastery": [
        "../../.upstream/dsh/vendor/schemastery/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-settings/client": [
        "../../.upstream/dsh/packages/client/ui-settings/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-primitives": [
        "../../.upstream/dsh/packages/client/ui-primitives/lib/types/index.d.ts"
      ]
    }
  },
  "include": ["src", "tests"]
}
