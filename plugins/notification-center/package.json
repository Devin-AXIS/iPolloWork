{
  "name": "@ipollo/dsh-notification-center",
  "version": "0.1.5",
  "description": "Notification inbox and source contract for iPolloWork plugins.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": "0.2.3-alpha.2"
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./contract": {
      "types": "./lib/contract.d.ts"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session-status",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc src/contract.ts --declaration --emitDeclarationOnly --outDir lib --skipLibCheck",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && npm test && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "3.20.0-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "lucide-react": "0.454.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
