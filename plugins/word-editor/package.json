{
  "name": "@ipollo/dsh-word-editor",
  "version": "0.1.1",
  "description": "Edit and save Word documents in the iPolloWork document sidebar.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.3-alpha.2"
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "scripts": {
    "build:source": "node scripts/build-engine-source.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@docx-editor.dev/core": "2.39.0",
    "@docx-editor.dev/react": "2.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "typescript": "^5.9.0"
  }
}
