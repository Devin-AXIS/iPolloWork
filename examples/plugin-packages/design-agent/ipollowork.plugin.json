{
  "schemaVersion": 1,
  "id": "design-agent",
  "name": "iPolloWork Design Agent",
  "description": "管理 iPolloWork Design Studio 与演示文稿的官方 Agent Skills，不改变内置设计工作台、模板或项目文件。",
  "category": "创作与设计",
  "source": {
    "format": "ipollowork-extension-manifest",
    "origin": "builtin",
    "trusted": true,
    "reference": "https://github.com/Devin-AXIS/iPolloWork"
  },
  "icon": {
    "src": "ipollowork-mark.svg"
  },
  "composer": {
    "prompt": "使用 iPolloWork Design Agent 在当前会话的设计项目中创建或编辑内容。"
  },
  "package": {
    "version": "0.1.0",
    "publisher": {
      "id": "ipollowork",
      "name": "iPolloWork"
    },
    "compatibility": {
      "ipollowork": ">=0.18.0",
      "opencode": ">=1.18.0"
    },
    "updateId": "ipollowork/design-agent",
    "entrypoints": {}
  },
  "permissions": [
    {
      "id": "workspace-read",
      "reason": "读取当前会话中用户选择的设计文件、模板和设计 Token。"
    },
    {
      "id": "workspace-write",
      "reason": "按照用户要求更新当前会话的设计或演示文稿文件。"
    }
  ],
  "resources": [
    {
      "type": "skill",
      "id": "ipollowork-design-studio",
      "label": "Design Studio",
      "description": "在当前 iPolloWork Design 会话中安全创建和编辑 HTML 设计。",
      "path": ".opencode/skills/ipollowork-design-studio/SKILL.md",
      "provides": [
        "workflow:ipollowork-design-studio"
      ],
      "required": true
    },
    {
      "type": "skill",
      "id": "ipollowork-presentations",
      "label": "演示文稿",
      "description": "在当前 Design 会话中制作、修改和检查演示文稿。",
      "path": ".opencode/skills/ipollowork-presentations/SKILL.md",
      "provides": [
        "workflow:ipollowork-presentations"
      ],
      "required": true
    }
  ]
}
