# Default: built-in SQLite, no database server or credentials required.
ONTO_SQLITE_PATH=.data/onto.sqlite
# For optional PostgreSQL development, unset ONTO_SQLITE_PATH and set:
# DATABASE_URL=postgresql://localhost:5432/ipollowork_data
PORT=5711

# 可选：独立数据库连接的服务端加密密钥文件。省略时使用 .local/database.key。
# 备份时与数据库一同保留原密钥。也可配置 DATA_SECRET_KEY（32 字节的 Base64）。
# DATA_SECRET_FILE=/secure/path/ipollo-data.key

# 可选：自定义 API 的获准来源，使用完整 origin，多个来源以逗号分隔。
# DATA_API_ALLOWED_ORIGINS=https://api.example.com
# API 密钥只在服务端配置；字段仅保存 market-data 这样的凭据名称。
# 选择 query 或 header 其中一种。不要将真实密钥提交到代码库。
# DATA_API_CREDENTIALS={"market-data":{"origin":"https://www.alphavantage.co","query":"apikey","value":"replace-with-your-key"}}

# 可选：记录文档的本地图片目录；默认 .data/document-files。与数据库一同备份。
# DOCUMENT_FILES_DIR=/persistent/ipollo-data/document-files
