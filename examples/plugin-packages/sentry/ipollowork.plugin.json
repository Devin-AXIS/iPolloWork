{
  "schemaVersion": 1,
  "id": "sentry",
  "name": "Sentry",
  "description": "把生产问题调查、回归监控、发布健康和修复验证组合成有证据的 Sentry 工作流。",
  "category": "可观测性",
  "source": {
    "format": "ipollowork-extension-manifest",
    "origin": "builtin",
    "trusted": true,
    "reference": "https://docs.sentry.io/product/sentry-mcp/"
  },
  "icon": { "simpleIconSlug": "sentry" },
  "composer": { "prompt": "使用 Sentry 插件读取生产证据，先确认组织、项目、环境和时间范围，再调查问题或验证修复。" },
  "package": {
    "version": "1.0.0",
    "publisher": { "id": "ipollowork", "name": "iPolloWork" },
    "compatibility": { "ipollowork": ">=0.18.0", "opencode": ">=1.18.0" },
    "updateId": "ipollowork/sentry",
    "entrypoints": {}
  },
  "permissions": [
    { "id": "network", "reason": "连接 Sentry 官方远程 MCP，并读取用户通过 OAuth 授权的错误与发布数据。" },
    { "id": "workspace-read", "reason": "将 Sentry 堆栈、版本和提交证据与当前代码进行核对。", "optional": true }
  ],
  "resources": [
    {
      "type": "mcp",
      "id": "sentry-mcp",
      "label": "Sentry 官方远程 MCP",
      "description": "通过持久化 OAuth 读取用户授权的 Sentry 组织、项目、Issue 和发布数据。",
      "path": ".opencode/mcps/sentry.json",
      "mcpServerName": "sentry",
      "oauth": true,
      "required": true
    },
    {
      "type": "skill",
      "id": "sentry-issue-investigation",
      "label": "生产问题调查",
      "description": "从事件、堆栈、标签和时间线定位最可能的根因。",
      "path": ".opencode/skills/sentry-issue-investigation/SKILL.md",
      "requires": ["resource:sentry-mcp"],
      "provides": ["workflow:sentry-issue-investigation"],
      "required": true
    },
    {
      "type": "skill",
      "id": "sentry-regression-monitoring",
      "label": "回归监控",
      "description": "比较版本和时间窗口，识别新问题、回归与影响变化。",
      "path": ".opencode/skills/sentry-regression-monitoring/SKILL.md",
      "requires": ["resource:sentry-mcp"],
      "provides": ["workflow:sentry-regression-monitoring"],
      "required": true
    },
    {
      "type": "skill",
      "id": "sentry-release-health",
      "label": "发布健康",
      "description": "用错误、用户影响和版本证据评估发布质量。",
      "path": ".opencode/skills/sentry-release-health/SKILL.md",
      "requires": ["resource:sentry-mcp"],
      "provides": ["workflow:sentry-release-health"],
      "required": true
    },
    {
      "type": "skill",
      "id": "sentry-fix-verification",
      "label": "修复验证",
      "description": "把代码修复、发布版本和生产事件趋势连接成闭环证据。",
      "path": ".opencode/skills/sentry-fix-verification/SKILL.md",
      "requires": ["resource:sentry-mcp"],
      "provides": ["workflow:sentry-fix-verification"],
      "required": true
    }
  ]
}
