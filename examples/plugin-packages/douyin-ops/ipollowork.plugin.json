{
  "schemaVersion": 2,
  "id": "douyin-ops",
  "name": "抖音运营台",
  "description": "面向普通用户的多账号抖音运营台：网页登录、视频发布、作品数据、评论回复及搜索后评论；可用 API 优先，其余由 AI 操作浏览器。",
  "category": "营销",
  "source": {
    "format": "ipollowork-extension-manifest",
    "origin": "builtin",
    "trusted": true,
    "reference": "https://github.com/Devin-AXIS/iPolloWork"
  },
  "package": {
    "version": "0.2.20",
    "publisher": {
      "id": "zjy-web222",
      "name": "zjy-web222"
    },
    "compatibility": {
      "ipollowork": ">=0.21.0"
    },
    "updateId": "local/douyin-ops"
  },
  "composer": {
    "prompt": "打开运营台使用 open-workbench。先阅读 douyin-ops-worker。制作并发布视频必须继续到后台自动导出 MP4、导入和发布，不能要求用户手动导出。普通用户用 connect-browser 登录并验证真实抖音号，无需开发者配置。有权限优先 API，返回 browserTask 必须用宿主浏览器完成并回写；pending 不是成功。搜索后评论用 comment-video。操作标识保持稳定。"
  },
  "resources": [
    {
      "type": "skill",
      "id": "douyin-ops-worker",
      "label": "抖音运营执行",
      "path": "skills/douyin-ops-worker",
      "required": true
    },
    {
      "type": "skill",
      "id": "douyin-ops-dispatcher",
      "label": "抖音日程调度",
      "path": "skills/douyin-ops-dispatcher",
      "required": true
    },
    {
      "type": "local-service",
      "id": "workbench",
      "label": "抖音运营台",
      "path": "service/workbench.mjs",
      "required": true,
      "actions": [
        {
          "id": "open-workbench",
          "title": "打开抖音运营台",
          "description": "启动本机工作台。应用密钥只在工作台设置中填写。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "id": "studio-state",
          "title": "查看运营台状态",
          "description": "读取账号、最近草稿、素材和执行结果，不返回平台令牌。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "id": "list-accounts",
          "title": "列出抖音账号",
          "description": "发布抖音前先调用。返回插件已有账号、网页登录身份、独立浏览器环境及实际可用路线；scopes 为空不代表不能网页发布。复用用户指定账号，未指定且只有一个账号时复用它，多账号先确认，不要新建账号或索要 API 密钥。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "id": "start-authorization",
          "title": "开始抖音授权",
          "description": "生成官方扫码授权地址；完成后在工作台粘贴回调地址。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "id": "import-media",
          "title": "导入视频工作台素材",
          "description": "导入当前工作区内真实 MP4 文件，最多128 MiB；返回素材ID。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "sourcePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "sourcePath"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "save-draft",
          "title": "保存抖音视频草稿",
          "description": "保存文案和素材，不发布。创建新草稿必须省略 id，由服务生成；runKey 是创建去重标识（即时发布也可用），重试复用。只有更新已有草稿才传返回的真实 id，不得自造 id。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "仅修改已有草稿时传入之前返回的 draft.id。新建草稿必须省略，不能自行命名；幂等标识请用 runKey。",
                "minLength": 1,
                "maxLength": 100
              },
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "title": {
                "type": "string",
                "maxLength": 100
              },
              "text": {
                "type": "string",
                "maxLength": 2000
              },
              "assetId": {
                "type": "string",
                "maxLength": 100
              },
              "runKey": {
                "type": "string",
                "description": "本次草稿创建的稳定去重标识，即时发布与日程都适用；重试保持不变。不是草稿 id。",
                "minLength": 1,
                "maxLength": 700
              }
            },
            "required": [
              "accountId",
              "title",
              "text"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "publish-draft",
          "title": "发布抖音视频",
          "description": "所有抖音发布的统一入口，先保存草稿再用返回的 draft.id 调用，创建可追踪记录。仅用户授权后执行；有 API 权限走 API，否则用已有账号的 browserTask，无需开放平台配置。operationKey 重试不变。网页发布必须 claim-browser-job → 浏览器操作 → finish-browser-job → get-job；验证码或不确定结果也必须记录，禁止跳过插件直接发布。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "draftId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "operationKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 700
              }
            },
            "required": [
              "accountId",
              "draftId",
              "operationKey"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "list-videos",
          "title": "查询授权账号作品",
          "description": "官方历史video.list接口，仅适用已开通权限的应用。每页最多20条。 API 不可用时返回 browserTask，必须读取 douyin-ops-worker 并通过宿主浏览器完成、回写结果；pending 不是成功。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "cursor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "accountId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "video-data",
          "title": "查询作品数据",
          "description": "官方历史video.data接口，查询1至20个属于授权账号的作品。itemIds 也接受实际 /video/ 作品链接，此时走网页读取。 API 不可用时返回 browserTask，必须读取 douyin-ops-worker 并通过宿主浏览器完成、回写结果；pending 不是成功。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "itemIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            },
            "required": [
              "accountId",
              "itemIds"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "list-comments",
          "title": "查询作品评论",
          "description": "官方历史item.comment接口，查询授权账号自己的公开视频评论。 API 不可用时返回 browserTask，必须读取 douyin-ops-worker 并通过宿主浏览器完成、回写结果；pending 不是成功。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "itemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "cursor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "targetUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "ownVideo": {
                "type": "boolean"
              }
            },
            "required": [
              "accountId",
              "itemId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "reply-comment",
          "title": "回复作品评论",
          "description": "仅按用户授权回复指定评论；要求item.comment。operationKey必须稳定，不重复提交。 API 不可用时返回 browserTask，必须读取 douyin-ops-worker 并通过宿主浏览器完成、回写结果；pending 不是成功。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "itemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "commentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "operationKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 700
              },
              "targetUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "targetComment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "targetAuthor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "ownVideo": {
                "type": "boolean"
              }
            },
            "required": [
              "accountId",
              "content",
              "operationKey"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "search-videos",
          "title": "搜索抖音视频",
          "description": "使用官方应用令牌和aweme.dy.video_search能力。deviceId填写平台要求的设备标识；翻页必须原样传回searchId和cursor。 API 不可用时返回 browserTask，必须读取 douyin-ops-worker 并通过宿主浏览器完成、回写结果；pending 不是成功。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "keyword": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "deviceId": {
                "type": "string",
                "pattern": "^[0-9]{1,19}$"
              },
              "searchId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "cursor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "keyword"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "browser-target",
          "title": "打开抖音网页入口",
          "description": "仅导航，返回页面地址及账号浏览器环境，不会创建执行记录。不能用此操作代替 publish-draft；上传发布前必须保存草稿、创建并领取发布任务。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "type": "string",
                "enum": [
                  "creator",
                  "search"
                ]
              },
              "keyword": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "get-job",
          "title": "查看操作结果",
          "description": "先读取现有回执和待核对状态，再决定后续操作。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "jobId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "reconcile-publish-link",
          "title": "标记不可访问的公开链接",
          "description": "仅在官方页面证实已保存的公开链接不可访问时，移除可点击链接并保留发布成功及管理页回执；不会重发作品。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "expectedUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "jobId",
              "expectedUrl",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "resolve-job",
          "title": "回写人工核对结果",
          "description": "只核对现有 uncertain 任务并保存结果，不重新发送。网页写入确认成功必须提供实际 resultUrl 作品链接；验证码完成后先核对原任务。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "failed"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "resultUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "网页发布或评论确认成功时必填：实际 https://www.douyin.com/video/<数字ID> 作品链接。"
              }
            },
            "required": [
              "jobId",
              "outcome",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "connect-browser",
          "title": "登录抖音账号",
          "description": "创建或复用独立浏览器环境。返回入口；打开不等于已验证登录。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "id": "observe-browser-session",
          "title": "自动识别当前网页登录",
          "description": "宿主提供插件独立浏览器中 /user/self 的可见页面，核对本人管理入口、昵称、抖音号后连接对应账号。不读取 Cookie，不识别他人主页，不覆盖已绑定的其他抖音号。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "browserProfileId": {
                "type": "string",
                "format": "uuid"
              },
              "url": {
                "type": "string",
                "maxLength": 2000
              },
              "tree": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "browserProfileId",
              "url",
              "tree"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "verify-browser-account",
          "title": "记录网页登录身份",
          "description": "必须从当前浏览器的自己账号页面实际读取抖音号、昵称和主页地址；不能根据他人主页或昵称猜测。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "actualProfileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "actualAccount": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "nickname": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "profileUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "accountId",
              "actualProfileId",
              "actualAccount",
              "nickname",
              "profileUrl",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "claim-browser-job",
          "title": "领取网页任务",
          "description": "独占领取后按 douyin-ops-worker 使用宿主浏览器执行；同账号忙时返回 queued，领取成功后返回素材路径。先在任务账号 profileId 打开入口，用本轮返回的新 tabId snapshot 核对身份；标签失效可同环境重开继续原任务，最多2次。已中断读取可 cancel-read-job 后领取原排队任务，写操作不能强制解锁。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "actualProfileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "actualAccount": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "jobId",
              "actualProfileId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "cancel-read-job",
          "title": "结束读取任务",
          "description": "仅结束已停止或中断的网页搜索、作品/评论/数据读取，释放账号占用并保留失败原因、废弃旧执行凭证。不停止其他会话，须先确认原读取已停止。不能结束发布、评论发送或 API 任务，不会提交或重建排队发布。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "jobId",
              "accountId",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "finish-browser-job",
          "title": "保存网页操作结果",
          "description": "只记录实际页面证据；内容管理出现匹配作品即为平台受理。公开链接尚不可访问时不要从作品 ID 猜测 URL，省略 resultUrl；提交后无法核对才用 outcome=uncertain，不可重发。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "executionToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "actualProfileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "actualAccount": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "failed",
                  "uncertain"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "resultUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "publicationStatus": {
