{
  "schemaVersion": 2,
  "id": "douyin-ops",
  "name": "抖音运营台",
  "description": "面向普通用户的多账号抖音运营台：网页登录、视频发布、作品数据、评论回复及搜索后评论；可用 API 优先，其余由 AI 操作浏览器。",
  "category": "营销",
  "source": {
    "format": "ipollowork-extension-manifest",
    "origin": "builtin",
    "trusted": true,
    "reference": "https://github.com/Devin-AXIS/iPolloWork"
  },
  "package": {
    "version": "0.2.13",
    "publisher": {
      "id": "zjy-web222",
      "name": "zjy-web222"
    },
    "compatibility": {
      "ipollowork": ">=0.21.0"
    },
    "updateId": "local/douyin-ops"
  },
  "composer": {
    "prompt": "打开运营台使用 open-workbench。先阅读 douyin-ops-worker。制作并发布视频必须继续到后台自动导出 MP4、导入和发布，不能要求用户手动导出。普通用户用 connect-browser 登录并验证真实抖音号，无需开发者配置。有权限优先 API，返回 browserTask 必须用宿主浏览器完成并回写；pending 不是成功。搜索后评论用 comment-video。操作标识保持稳定。"
  },
  "resources": [
    {
      "type": "skill",
      "id": "douyin-ops-worker",
      "label": "抖音运营执行",
      "path": "skills/douyin-ops-worker",
      "required": true
    },
    {
      "type": "skill",
      "id": "douyin-ops-dispatcher",
      "label": "抖音日程调度",
      "path": "skills/douyin-ops-dispatcher",
      "required": true
    },
    {
      "type": "local-service",
      "id": "workbench",
      "label": "抖音运营台",
      "path": "service/workbench.mjs",
      "required": true,
      "actions": [
        {
          "id": "open-workbench",
          "title": "打开抖音运营台",
          "description": "启动本机工作台。应用密钥只在工作台设置中填写。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "id": "studio-state",
          "title": "查看运营台状态",
          "description": "读取账号、最近草稿、素材和执行结果，不返回平台令牌。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "id": "list-accounts",
          "title": "列出抖音账号",
          "description": "按用户指定账号选择；返回真实 OAuth 身份和已授予权限。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "id": "start-authorization",
          "title": "开始抖音授权",
          "description": "生成官方扫码授权地址；完成后在工作台粘贴回调地址。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "id": "import-media",
          "title": "导入视频工作台素材",
          "description": "导入当前工作区内真实 MP4 文件，最多128 MiB；返回素材ID。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "sourcePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "sourcePath"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "save-draft",
          "title": "保存抖音视频草稿",
          "description": "保存文案和素材，不发布。创建新草稿必须省略 id，由服务生成；runKey 是创建去重标识（即时发布也可用），重试复用。只有更新已有草稿才传返回的真实 id，不得自造 id。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "仅修改已有草稿时传 studio-state/save-draft 返回的真实 draft.id。创建时省略，不可编造。",
                "minLength": 1,
                "maxLength": 100
              },
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "title": {
                "type": "string",
                "maxLength": 100
              },
              "text": {
                "type": "string",
                "maxLength": 2000
              },
              "assetId": {
                "type": "string",
                "maxLength": 100
              },
              "runKey": {
                "type": "string",
                "description": "本次草稿创建的稳定去重标识，即时发布与日程都适用；重试保持不变。不是草稿 id。",
                "minLength": 1,
                "maxLength": 700
              }
            },
            "required": [
              "accountId",
              "title",
              "text"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "publish-draft",
          "title": "发布抖音视频",
          "description": "仅在用户授权发布已保存内容后执行；要求video.create.bind。operationKey重试不可改变。超时返回待核对，禁止重发。 API 不可用时返回 browserTask，必须读取 douyin-ops-worker 并通过宿主浏览器完成、回写结果；pending 不是成功。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "draftId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "operationKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 700
              }
            },
            "required": [
              "accountId",
              "draftId",
              "operationKey"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "list-videos",
          "title": "查询授权账号作品",
          "description": "官方历史video.list接口，仅适用已开通权限的应用。每页最多20条。 API 不可用时返回 browserTask，必须读取 douyin-ops-worker 并通过宿主浏览器完成、回写结果；pending 不是成功。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "cursor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "accountId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "video-data",
          "title": "查询作品数据",
          "description": "官方历史video.data接口，查询1至20个属于授权账号的作品。itemIds 也接受实际 /video/ 作品链接，此时走网页读取。 API 不可用时返回 browserTask，必须读取 douyin-ops-worker 并通过宿主浏览器完成、回写结果；pending 不是成功。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "itemIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            },
            "required": [
              "accountId",
              "itemIds"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "list-comments",
          "title": "查询作品评论",
          "description": "官方历史item.comment接口，查询授权账号自己的公开视频评论。 API 不可用时返回 browserTask，必须读取 douyin-ops-worker 并通过宿主浏览器完成、回写结果；pending 不是成功。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "itemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "cursor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "targetUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "ownVideo": {
                "type": "boolean"
              }
            },
            "required": [
              "accountId",
              "itemId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "reply-comment",
          "title": "回复作品评论",
          "description": "仅按用户授权回复指定评论；要求item.comment。operationKey必须稳定，不重复提交。 API 不可用时返回 browserTask，必须读取 douyin-ops-worker 并通过宿主浏览器完成、回写结果；pending 不是成功。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "itemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "commentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "operationKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 700
              },
              "targetUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "targetComment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "targetAuthor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "ownVideo": {
                "type": "boolean"
              }
            },
            "required": [
              "accountId",
              "content",
              "operationKey"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "search-videos",
          "title": "搜索抖音视频",
          "description": "使用官方应用令牌和aweme.dy.video_search能力。deviceId填写平台要求的设备标识；翻页必须原样传回searchId和cursor。 API 不可用时返回 browserTask，必须读取 douyin-ops-worker 并通过宿主浏览器完成、回写结果；pending 不是成功。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "keyword": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "deviceId": {
                "type": "string",
                "pattern": "^[0-9]{1,19}$"
              },
              "searchId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "cursor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "keyword"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "browser-target",
          "title": "打开抖音网页入口",
          "description": "返回创作者中心或搜索页面地址及账号独立浏览器环境。网页打开不代表登录验证或发布成功。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "type": "string",
                "enum": [
                  "creator",
                  "search"
                ]
              },
              "keyword": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "get-job",
          "title": "查看操作结果",
          "description": "先读取现有回执和待核对状态，再决定后续操作。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "jobId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "resolve-job",
          "title": "回写人工核对结果",
          "description": "只在用户或实际浏览器证据确认待核对操作是否成功后调用；记录依据，不重新发送。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "failed"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "jobId",
              "outcome",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "connect-browser",
          "title": "登录抖音账号",
          "description": "创建或复用独立浏览器环境。返回入口；打开不等于已验证登录。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "id": "verify-browser-account",
          "title": "记录网页登录身份",
          "description": "必须从当前浏览器的自己账号页面实际读取抖音号、昵称和主页地址；不能根据他人主页或昵称猜测。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "actualProfileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "actualAccount": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "nickname": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "profileUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "accountId",
              "actualProfileId",
              "actualAccount",
              "nickname",
              "profileUrl",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "claim-browser-job",
          "title": "领取网页任务",
          "description": "独占领取后按 douyin-ops-worker 使用宿主浏览器执行；素材路径在领取结果中返回。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "actualProfileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "actualAccount": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "jobId",
              "actualProfileId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "finish-browser-job",
          "title": "保存网页操作结果",
          "description": "只记录实际页面证据；提交后不确定必须 outcome=uncertain，不可重发。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "executionToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "actualProfileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "actualAccount": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "failed",
                  "uncertain"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "resultUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "items": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "item_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "comment_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "nickname": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "content": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "targetAuthor": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "link": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "statistics": {
                      "type": "object",
                      "properties": {
                        "play_count": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 40
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "digg_count": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 40
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "comment_count": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 40
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "share_count": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 40
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "title"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "jobId",
              "executionToken",
              "actualProfileId",
              "outcome",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "comment-video",
          "title": "在视频下发表评论",
          "description": "对指定实际作品链接发布一条顶层评论，通过 AI 浏览器执行；operationKey 重试不变。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "targetUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "operationKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 700
              }
            },
            "required": [
              "accountId",
              "targetUrl",
              "content",
              "operationKey"
            ],
            "additionalProperties": false
          }
        }
      ],
      "browserSession": {
        "origin": "https://www.douyin.com",
        "paths": [
          "/"
        ],
        "observeAction": "observe-browser-session"
      }
    },
    {
      "type": "file",
      "id": "runtime-files",
      "label": "抖音服务模块",
      "path": "service",
      "required": true
    },
    {
      "type": "file",
      "id": "workbench-files",
      "label": "抖音工作台页面",
      "path": "ui",
      "required": true
    }
  ],
  "localization": {
    "defaultLocale": "zh",
    "translations": {
      "en": {
        "name": "Douyin Operations",
        "description": "Douyin console for ordinary users: browser login, API-first operations, AI browser publishing, analytics, search and comments.",
        "category": "Marketing",
