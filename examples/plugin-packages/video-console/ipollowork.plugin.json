{
  "schemaVersion": 2,
  "id": "video-console",
  "name": "视频工作台",
  "description": "用工具栏剪辑、裁切、旋转和调整视频；通过独立 AI 入口生成或修改内容。",
  "category": "设计与创作",
  "defaultEnabled": true,
  "source": {
    "format": "ipollowork-extension-manifest",
    "origin": "builtin",
    "trusted": true,
    "reference": "https://github.com/Devin-AXIS/iPolloWork"
  },
  "package": {
    "version": "0.2.42",
    "publisher": {
      "id": "ipollowork",
      "name": "iPolloWork"
    },
    "compatibility": {
      "ipollowork": ">=0.21.0"
    },
    "updateId": "ipollowork/video-console"
  },
  "permissions": [
    {
      "id": "workspace-read",
      "reason": "读取用户选择的视频、图片和音频参考。"
    },
    {
      "id": "workspace-write",
      "reason": "保存剪辑副本；仅在用户确认后覆盖当前视频。"
    }
  ],
  "resources": [
    {
      "type": "ui",
      "id": "console",
      "label": "视频工作台",
      "path": "ui/video-console.html",
      "required": true,
      "ui": {
        "uri": "ui://video-console/console",
        "mimeType": "text/html;profile=mcp-app",
        "prefersBorder": false
      }
    },
    {
      "type": "local-service",
      "id": "video-console-service",
      "label": "视频工作台服务",
      "path": "service/video-console.mjs",
      "required": true,
      "requires": [
        "action:video-generation/status",
        "action:video-generation/jobs",
        "action:video-generation/submit",
        "action:video-generation/recover",
        "action:video-generation/import",
        "action:video-generation/read",
        "action:video-generation/inspect",
        "action:video-generation/local-edit"
      ],
      "provides": [
        "action:status",
        "action:jobs",
        "action:submit",
        "action:recover",
        "action:import",
        "action:read",
        "action:inspect",
        "action:local-edit"
      ],
      "actions": [
        {
          "id": "status",
          "title": "检查视频模型",
          "description": "检查视频模型",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "id": "jobs",
          "title": "查看本会话视频任务",
          "description": "查看本会话视频任务",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "before": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "id": "submit",
          "title": "生成或编辑视频",
          "description": "生成或编辑视频",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              },
              "duration": {
                "type": "string"
              },
              "ratio": {
                "type": "string"
              },
              "firstFrame": {
                "type": "string"
              },
              "lastFrame": {
                "type": "string"
              },
              "imageRefs": {
                "type": "string"
              },
              "videoRefs": {
                "type": "string"
              },
              "audioRefs": {
                "type": "string"
              },
              "generateAudio": {
                "type": "string"
              },
              "watermark": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "id": "recover",
          "title": "恢复已有任务查询",
          "description": "恢复已有任务查询",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "upstreamId": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "id": "import",
          "title": "导入视频素材",
          "description": "导入视频素材",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string"
              },
              "dataUrl": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "id": "read",
          "title": "预览视频素材",
          "description": "预览视频素材",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "offset": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "id": "inspect",
          "title": "读取视频剪辑信息",
          "description": "读取视频尺寸、时长和版本，不调用模型。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "local-edit",
          "title": "保存工具栏剪辑",
          "description": "用本地工具处理视频，支持覆盖或另存为，不调用模型。",
          "effect": "write",
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "path": {
                "type": "string",
                "maxLength": 1000
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "copy",
                  "overwrite"
                ]
              },
              "start": {
                "type": "number",
                "minimum": 0,
                "maximum": 3600
              },
              "end": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3600
              },
              "rotation": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 0
                  },
                  {
                    "type": "number",
                    "const": 90
                  },
                  {
                    "type": "number",
                    "const": 180
                  },
                  {
                    "type": "number",
                    "const": 270
                  }
                ]
              },
              "flip": {
                "type": "boolean"
              },
              "speed": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "crop": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "requestId",
              "path",
              "revision",
              "mode",
              "start",
              "end",
              "rotation",
              "flip",
              "speed",
              "volume",
              "crop"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  ],
  "contributions": [
    {
      "type": "workspace-app",
      "ref": "console",
      "label": "视频工作台",
      "description": "通过工具栏编辑视频，或使用 AI 生成和修改内容。"
    },
    {
      "type": "conversation-template",
      "label": "生成或编辑视频",
      "description": "在右侧打开视频工作台。",
      "prompt": "打开视频工作台。常规剪辑使用工具栏，只有生成、延长或内容修改才调用 AI；保存前选择覆盖或另存为。",
      "mode": "video"
    }
  ],
  "localization": {
    "defaultLocale": "zh",
    "translations": {
      "en": {
        "name": "Video Workbench",
        "description": "Edit video with local toolbar tools, or use AI to generate and change content.",
        "category": "Design & Creative",
        "permissions": {
          "workspace-read": {
            "reason": "Read video, image and audio references selected by the user."
          },
          "workspace-write": {
            "reason": "Save edited copies; overwrite the current video only after user confirmation."
          }
        },
        "resources": {
          "console": {
            "label": "Video Workbench"
          },
          "video-console-service": {
            "label": "Video Workbench Service"
          }
        }
      }
    }
  }
}
