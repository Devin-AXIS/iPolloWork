{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["replies"],
  "properties": {
    "replies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["remoteCommentId", "body"],
        "properties": {
          "remoteCommentId": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
