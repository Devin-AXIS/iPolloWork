{
  "schemaVersion": 2,
  "id": "xiaohongshu-ops",
  "name": "小红书运营台",
  "description": "小红书多账号发帖与评论：AI 内容、图片与视频工作台素材、关键词找帖、筛选及批量评论，支持主软件与日程控制。",
  "category": "营销",
  "source": {
    "format": "ipollowork-extension-manifest",
    "origin": "local",
    "trusted": false
  },
  "package": {
    "version": "0.4.2",
    "publisher": {
      "id": "local",
      "name": "本地插件"
    },
    "compatibility": {
      "ipollowork": ">=0.21.0"
    },
    "updateId": "local/xiaohongshu-ops"
  },
  "composer": {
    "prompt": "打开运营台使用 open-workbench。先读 xhs-ops-worker 技能，按用户指定账号使用独立浏览器 profileId。发帖使用 save-post-draft、import-media、prepare-draft-publish；评论使用 create-post-search、save-search-results、update-comment-candidates、prepare-comment-batch；每项执行需 claim-job/complete-job。仅按用户授权范围发布或评论；草稿与润色不自动发送。"
  },
  "resources": [
    {
      "type": "skill",
      "id": "xhs-ops-worker",
      "label": "小红书账号任务执行",
      "path": "skills/xhs-ops-worker",
      "required": true
    },
    {
      "type": "skill",
      "id": "xhs-ops-dispatcher",
      "label": "小红书任务调度",
      "path": "skills/xhs-ops-dispatcher",
      "required": true
    },
    {
      "type": "local-service",
      "id": "workbench",
      "label": "小红书运营台",
      "path": "service/workbench.mjs",
      "actions": [
        {
          "id": "open-workbench",
          "title": "打开小红书运营台",
          "description": "直接启动本机运营台并返回页面地址，不调用 AI 对话。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "id": "list-accounts",
          "title": "列出小红书账号",
          "description": "返回已接入账号的小红书号、独立浏览器 profileId 和内容要求。日程执行时先按用户指定的小红书号选定账号，不自行换号。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "id": "prepare-job",
          "title": "准备发文或互动",
          "description": "把用户授权的发文、评论或回复锁定为当前会话的操作。日程须原样传入调度提示的 runKey；每个操作使用稳定 operationKey，重复调用不会新增。publish_note 需要标题、正文，以及 mediaAssetIds 素材或三张内容卡；视频必须 mediaKind=video 和一个 MP4 素材；create_comment 需要帖子地址和正文；reply_comment 另需目标评论原文与作者。返回账号浏览器环境与待执行内容。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "integer",
                "minimum": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "publish_note",
                  "create_comment",
                  "reply_comment"
                ]
              },
              "runKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "description": "日程提示中的 runKey；普通手动会话可省略。"
              },
              "operationKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "本次任务内稳定的操作编号，例如 post-1 或 reply-评论ID。重试时不可更换。"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "topics": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                }
              },
              "cards": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "heading": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "body": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 600
                    }
                  },
                  "required": [
                    "heading",
                    "body"
                  ],
                  "additionalProperties": false
                }
              },
              "targetUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "目标小红书帖子的完整地址。"
              },
              "targetCommentText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "可见的目标评论原文。"
              },
              "targetAuthor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "可见的目标评论作者。"
              },
              "mediaAssetIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80
                },
                "maxItems": 9
              },
              "mediaKind": {
                "type": "string",
                "enum": [
                  "image",
                  "video"
                ]
              }
            },
            "required": [
              "accountId",
              "type",
              "operationKey",
              "body"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "get-job",
          "title": "查看执行结果",
          "description": "读取已有操作的锁定内容、执行状态和结果地址。任务已成功或结果不确定时，不得再次提交。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "pattern": "^[a-fA-F0-9-]{36}$"
              }
            },
            "required": [
              "jobId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "rebind-session",
          "title": "更新账号绑定会话",
          "description": "首次发送消息生成正式会话后更新已绑定账号的会话 ID。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "previousSessionId": {
                "type": "string"
              },
              "sessionId": {
                "type": "string"
              }
            },
            "required": [
              "previousSessionId",
              "sessionId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "claim-job",
          "title": "领取小红书执行任务",
          "description": "领取当前会话准备的发文或互动任务，或已绑定会话的账号验证任务。发文互动前必须打开返回的账号独立浏览器，从实际可见页面读出 actualAccount 和 actualProfileId；不可把配置值当作观察结果。账号不匹配、另有操作执行中或待核对时会拒绝。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "pattern": "^[a-fA-F0-9-]{36}$"
              },
              "accountId": {
                "type": "integer",
                "minimum": 1
              },
              "actualAccount": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "actualProfileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "jobId",
              "accountId"
            ],
            "additionalProperties": false
          },
          "effect": "write"
        },
        {
          "id": "complete-job",
          "title": "回写小红书执行结果",
          "description": "仅在浏览器页面确认操作成功后回写匹配的账号、小红书号和真实结果地址。发文会进入文章记录，评论回复会进入互动记录。验证任务保持原行为。提交后无法确认成功时调用 uncertain-job，不能重发。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "pattern": "^[a-fA-F0-9-]{36}$"
              },
              "actualAccount": {
                "type": "string"
              },
              "actualProfileId": {
                "type": "string"
              },
              "resultUrl": {
                "type": "string"
              },
              "analyticsCsv": {
                "type": "string",
                "maxLength": 500000
              }
            },
            "required": [
              "jobId",
              "actualAccount",
              "actualProfileId"
            ],
            "additionalProperties": false
          },
          "effect": "write"
        },
        {
          "id": "block-job",
          "title": "报告小红书执行阻塞",
          "description": "登录失效、验证码、身份不匹配或页面无法操作时回写具体原因。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "pattern": "^[a-fA-F0-9-]{36}$"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "jobId",
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "effect": "write"
        },
        {
          "id": "observe-browser-session",
          "title": "自动识别账号登录",
          "description": "核对软件内创作平台的可见账号身份，自动连接匹配账号。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "browserProfileId": {
                "type": "string",
                "format": "uuid"
              },
              "url": {
                "type": "string",
                "maxLength": 2000
              },
              "tree": {
                "type": "string",
                "maxLength": 100000
              },
              "avatarUrl": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": [
              "url",
              "tree"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "fail-job",
          "title": "报告执行失败",
          "description": "确定尚未提交且操作失败时记录错误。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "pattern": "^[a-fA-F0-9-]{36}$"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "jobId",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "uncertain-job",
          "title": "报告结果待核对",
          "description": "已经点击提交，但未看到明确成功证据时记录待核对；禁止再次发送。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "pattern": "^[a-fA-F0-9-]{36}$"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "jobId",
              "message"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "studio-state",
          "title": "查看发帖草稿与搜索结果",
          "description": "读取所选账号最近50篇草稿、10次搜索与100个素材；可传 draftId 或 searchId 精确读取。浏览器请以 list-accounts 返回的 browserProfileId 为准。",
          "effect": "read",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "integer",
                "minimum": 1
              },
              "draftId": {
                "type": "string",
                "maxLength": 80
              },
              "searchId": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "accountId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "save-post-draft",
          "title": "保存发帖草稿 / 预设",
          "description": "保存完整草稿，不发布。提供 id 更新；省略 id 新建。已准备发布的草稿内容锁定。生成图片或视频后 import-media，再把素材ID写入 assetIds。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "integer",
                "minimum": 1
              },
              "id": {
                "type": "string",
                "maxLength": 80
              },
              "name": {
                "type": "string",
                "maxLength": 80
              },
              "title": {
                "type": "string",
                "maxLength": 100
              },
              "body": {
                "type": "string",
                "maxLength": 10000
              },
              "brief": {
                "type": "string",
                "maxLength": 4000
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 50
                },
                "maxItems": 10
              },
              "mediaKind": {
                "type": "string",
                "enum": [
                  "image",
                  "video"
                ]
              },
              "assetIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80
                },
                "maxItems": 9
              },
              "runKey": {
                "type": "string",
                "maxLength": 700,
                "description": "日程运行标识加稳定操作后缀，例如调度runKey:post-1；同一个值重试返回已有草稿/搜索，防止重复创建。"
              }
            },
            "required": [
              "accountId",
              "name",
              "title",
              "body",
              "mediaKind",
              "assetIds"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "create-post-search",
          "title": "新建关键词找帖",
          "description": "保存本次搜索条件；通过所选账号浏览器可见页面搜索，再 save-search-results 回写。只创建配置，不自动发送评论。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "integer",
                "minimum": 1
              },
              "query": {
                "type": "string",
                "maxLength": 100
              },
              "sort": {
                "type": "string",
                "enum": [
                  "general",
                  "newest",
                  "likes",
                  "comments",
                  "collections"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "exclude": {
                "type": "string",
                "maxLength": 500
              },
              "instruction": {
                "type": "string",
                "maxLength": 3000
              },
              "runKey": {
                "type": "string",
                "maxLength": 700,
                "description": "日程运行标识加稳定操作后缀，例如调度runKey:post-1；同一个值重试返回已有草稿/搜索，防止重复创建。"
              }
            },
            "required": [
              "accountId",
              "query"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "save-search-results",
          "title": "保存真实帖子候选",
          "description": "只保存当前搜索的真实、可见帖子；未知指标为 null，不得编造。每个帖子只出现一次。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "integer",
                "minimum": 1
              },
              "searchId": {
                "type": "string",
                "maxLength": 80
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "title": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "author": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "excerpt": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "publishedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 40
                    },
                    "likes": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "comments": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "collections": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  },
                  "required": [
                    "url",
                    "title"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100
              }
            },
            "required": [
              "accountId",
              "searchId",
              "results"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "update-comment-candidates",
          "title": "筛选帖子并保存评论",
          "description": "保存 AI 筛选、润色或人工编辑结果；每项必须属于当前列表。未传入的候选保持原样。不会发表评论。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "integer",
                "minimum": 1
              },
              "searchId": {
                "type": "string",
                "maxLength": 80
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "selected": {
                      "type": "boolean"
                    },
                    "comment": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "reason": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "id",
                    "selected",
                    "comment"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100
              },
              "instruction": {
                "type": "string",
                "maxLength": 3000
              },
              "exclude": {
                "type": "string",
                "maxLength": 500
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "accountId",
              "searchId",
              "items"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "set-search-error",
          "title": "记录搜索失败",
          "description": "搜索受登录、平台提示等阻塞时回写实际原因。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "integer",
                "minimum": 1
              },
              "searchId": {
                "type": "string",
                "maxLength": 80
              },
              "error": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "accountId",
              "searchId",
              "error"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "prepare-draft-publish",
          "title": "准备发布草稿",
          "description": "仅在用户授权发布后调用。将草稿锁定为当前会话操作，返回 job；重复调用不重复发布。接着按 worker 技能核对身份、claim、发布和回写。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "integer",
                "minimum": 1
              },
              "draftId": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "accountId",
              "draftId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "prepare-comment-batch",
          "title": "准备批量评论",
          "description": "仅在用户授权发表评论时调用。锁定所选帖子的评论，跳过命中排除词及已有评论操作的帖子。逐个执行返回 jobs 并确认结果，不并发提交。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "integer",
                "minimum": 1
              },
              "searchId": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "accountId",
              "searchId"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "import-media",
          "title": "导入工作台素材",
          "description": "导入图片工作台或视频工作台已生成的当前工作区文件。支持 PNG/JPEG/WebP（15MB）与 MP4（200MB）；返回 asset.id。路径必须真实存在，不能传 URL。",
          "effect": "write",
          "inputSchema": {
            "type": "object",
            "properties": {
              "sourcePath": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "sourcePath"
            ],
            "additionalProperties": false
          }
        }
      ],
      "required": true,
      "browserSession": {
        "loginUi": {
          "path": "/login",
          "whenText": "短信登录",
          "selector": "div:has(button.beer-login-btn) > img"
        },
        "origin": "https://creator.xiaohongshu.com",
        "observeAction": "observe-browser-session",
        "paths": [
          "/login",
          "/new/home"
        ],
        "avatarSelector": "img.user_avatar"
      }
    }
  ],
  "localization": {
    "defaultLocale": "zh",
    "translations": {
      "en": {
