{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "feedback-loop",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Feedback Loop",
  "description": "Explain a repeatable review-and-improve cycle.",
  "tags": [
    "component",
    "diagrams",
    "orbit",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "diagrams",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four cycle stages. Keep pipe separators between items and preserve the orbit layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "feedback-loop.html",
      "target": "compositions/feedback-loop.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Feedback Loop",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Observe::Read the signal|Draft::Make a move|Review::Test the result|Learn::Update the system",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A useful loop gets sharper every pass",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
