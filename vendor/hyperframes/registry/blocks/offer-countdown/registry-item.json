{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "offer-countdown",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Offer Countdown",
  "description": "Present a time-sensitive offer without visual clutter.",
  "tags": [
    "component",
    "brand",
    "spotlight",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "brand",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four offer and timer. Keep pipe separators between items and preserve the spotlight layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "offer-countdown.html",
      "target": "compositions/offer-countdown.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Offer Countdown",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "48H::Launch window|20%::Team plan|BONUS::Template pack|CTA::Start now",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "One offer, one deadline, one next action",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
