{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "territory-heat-map",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Territory Heat Map",
  "description": "An abstract regional heat map that reveals local territories by intensity and emphasizes one selected region.",
  "tags": ["component", "map", "regions", "heat-map", "territory", "theme"],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "maps",
    "surfaces": ["video"],
    "themeMode": "inherit",
    "data": {
      "version": 1,
      "kind": "region-value",
      "mode": "replace",
      "rowId": "region",
      "binding": { "variable": "regions", "encoding": "key-value-list" },
      "columns": [
        { "id": "region", "label": "Region", "labelZh": "区域", "type": "string", "role": "id", "required": true },
        { "id": "value", "label": "Intensity", "labelZh": "强度", "type": "number", "role": "value", "required": true }
      ],
      "minRows": 2,
      "maxRows": 8,
      "highlightVariable": "highlight",
      "valueFormat": { "precision": 0, "notation": "standard" }
    },
    "ai": {
      "slots": ["title", "regions", "highlight", "source"],
      "instructions": "Provide two to eight local regions with numeric intensity values. This is an abstract territory view and must not be presented as a precise political boundary map."
    }
  },
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 7,
  "engine": { "name": "gsap", "version": "3.13.0", "seekable": true },
  "files": [{ "path": "territory-heat-map.html", "target": "compositions/territory-heat-map.html", "type": "hyperframes:composition" }],
  "variables": [
    { "id": "title", "label": "Title", "type": "string", "default": "Demand intensity by territory", "maxLength": 72, "update": "live" },
    { "id": "regions", "label": "Regions", "description": "Local region names and intensity values.", "type": "string", "default": "North:87,Harbor:76,Central:96,East:64,South:58,West:71,River:82,Hills:49", "maxLength": 1400, "update": "live" },
    { "id": "highlight", "label": "Highlight", "type": "string", "default": "Central", "maxLength": 40, "update": "live" },
    { "id": "source", "label": "Source", "type": "string", "default": "Illustrative demand index", "maxLength": 72, "update": "live" }
  ]
}
