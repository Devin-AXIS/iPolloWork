{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "sparkline-grid",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Sparkline Grid",
  "description": "Compare several short-term trends in one frame.",
  "tags": [
    "component",
    "data",
    "dashboard",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "data",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four trend cards. Keep pipe separators between items and preserve the dashboard layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "sparkline-grid.html",
      "target": "compositions/sparkline-grid.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Sparkline Grid",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Demand::↗ 18%|Quality::↗ 7%|Latency::↘ 22%|Adoption::↗ 31%",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Four trends across the current quarter",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
