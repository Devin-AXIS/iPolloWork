{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "opening-orbit-lockup",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Orbit Lockup",
  "description": "Fine orbital geometry converges on a central identity mark before the title settles into place.",
  "kind": "animation",
  "librarySection": "opening-animation",
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 4.8,
  "tags": ["opening", "orbit", "geometric", "brand", "technology"],
  "engine": { "name": "gsap", "version": "3.15.0", "seekable": true, "plugins": [] },
  "source": { "provider": "ipollowork", "label": "iPolloWork Motion Library" },
  "motionPreset": {
    "version": 1,
    "category": "opening",
    "targets": ["any", "text", "image", "shape", "group"],
    "anchor": "clip-start",
    "duration": 1.2,
    "ease": "expo.out",
    "keyframes": [
      {
        "percentage": 0,
        "properties": { "opacity": 0, "scale": 0.64, "rotation": -18, "filter": "blur(12px)" }
      },
      {
        "percentage": 68,
        "properties": { "opacity": 1, "scale": 1.035, "rotation": 1, "filter": "blur(0px)" }
      },
      {
        "percentage": 100,
        "properties": { "opacity": 1, "scale": 1, "rotation": 0, "filter": "blur(0px)" }
      }
    ]
  },
  "files": [
    {
      "path": "opening-orbit-lockup.html",
      "target": "compositions/opening-orbit-lockup.html",
      "type": "hyperframes:composition"
    }
  ]
}
