{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "conversion-funnel",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Conversion Funnel",
  "description": "Explain how an audience narrows toward a final action.",
  "tags": [
    "component",
    "data",
    "funnel",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "data",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four funnel stages. Keep pipe separators between items and preserve the funnel layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "conversion-funnel.html",
      "target": "compositions/conversion-funnel.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Conversion Funnel",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Views::100K|Qualified::34K|Trials::12K|Customers::3.8K",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Each stage names the next conversion opportunity",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
