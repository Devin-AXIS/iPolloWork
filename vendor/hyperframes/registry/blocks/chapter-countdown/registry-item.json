{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "chapter-countdown",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Chapter Countdown",
  "description": "Count into a chapter while previewing its key beats.",
  "tags": [
    "component",
    "scene",
    "columns",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "scene",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four chapter beats. Keep pipe separators between items and preserve the columns layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "chapter-countdown.html",
      "target": "compositions/chapter-countdown.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Chapter Countdown",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "03::Frame the issue|02::Reveal the signal|01::Make the move|NOW::Begin",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A countdown that also sets expectations",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
