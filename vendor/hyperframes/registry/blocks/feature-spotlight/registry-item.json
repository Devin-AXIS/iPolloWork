{
  "name": "feature-spotlight",
  "type": "hyperframes:block",
  "title": "产品功能聚焦台",
  "description": "立体能力层叠、逐项抽出聚焦、流光与动态说明。适合产品宣传和功能亮点。",
  "version": "1.0.0",
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "tags": [
    "component",
    "product",
    "isometric",
    "theme",
    "讲解",
    "宣传"
  ],
  "visualComponent": {
    "version": 1,
    "category": "product",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "data": {
      "version": 1,
      "kind": "category-value",
      "mode": "replace",
      "rowId": "label",
      "binding": {
        "variable": "nodes",
        "encoding": "json"
      },
      "columns": [
        {
          "id": "label",
          "label": "Name",
          "labelZh": "名称",
          "type": "string",
          "role": "label",
          "required": true
        },
        {
          "id": "icon",
          "label": "Icon",
          "labelZh": "图标",
          "type": "string",
          "role": "value",
          "options": [
            {
              "value": "workflow",
              "label": "工作流"
            },
            {
              "value": "settings",
              "label": "设置"
            },
            {
              "value": "zap",
              "label": "闪电"
            },
            {
              "value": "layers",
              "label": "图层"
            },
            {
              "value": "brain",
              "label": "智能"
            },
            {
              "value": "database",
              "label": "数据库"
            },
            {
              "value": "bot",
              "label": "机器人"
            },
            {
              "value": "globe",
              "label": "全球"
            },
            {
              "value": "cpu",
              "label": "算力"
            },
            {
              "value": "chart",
              "label": "分析"
            },
            {
              "value": "mail",
              "label": "消息"
            },
            {
              "value": "code",
              "label": "代码"
            }
          ]
        },
        {
          "id": "description",
          "label": "Description",
          "labelZh": "讲解内容",
          "type": "string",
          "role": "value"
        },
        {
          "id": "value",
          "label": "Value",
          "labelZh": "数字 / 关键词",
          "type": "string",
          "role": "value"
        },
        {
          "id": "image",
          "label": "Custom icon",
          "labelZh": "自定义图标",
          "type": "string",
          "role": "value",
          "format": "image"
        }
      ],
      "minRows": 2,
      "maxRows": 8
    },
    "ai": {
      "slots": [
        "title",
        "eyebrow",
        "nodes",
        "speed",
        "hold",
        "depth",
        "textSpeed",
        "cycle",
        "active",
        "glow",
        "labels",
        "grid"
      ],
      "instructions": "Edit native variables and structured node rows; do not rewrite the drawing. Icon is a provided enum or embedded image. Node count is the number of rows. Theme colors and typography inherit from the project. Playback is deterministic and owned by the host timeline."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 24,
  "engine": {
    "name": "gsap",
    "version": "3.14.2",
    "seekable": true
  },
  "files": [
    {
      "path": "feature-spotlight.html",
      "target": "compositions/feature-spotlight/feature-spotlight.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "gsap.min.js",
      "target": "compositions/feature-spotlight/gsap.min.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "NOTICE",
      "target": "compositions/feature-spotlight/NOTICE",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "主标题",
      "type": "string",
      "default": "让每一项能力，\n成为产品的亮点。",
      "maxLength": 48,
      "update": "reload"
    },
    {
      "id": "eyebrow",
      "label": "上方标注",
      "type": "string",
      "default": "FEATURES / IN FOCUS",
      "maxLength": 40,
      "update": "reload"
    },
    {
      "id": "nodes",
      "label": "节点 / 内容",
      "type": "string",
      "default": "{\"version\":1,\"kind\":\"category-value\",\"rows\":[{\"label\":\"连接一切\",\"description\":\"把工具、数据与应用，连接成一个协同工作的整体。\",\"value\":\"01\",\"icon\":\"globe\"},{\"label\":\"理解上下文\",\"description\":\"不仅接收指令，更理解目标与任务之间的关系。\",\"value\":\"02\",\"icon\":\"brain\"},{\"label\":\"自动化执行\",\"description\":\"让重复步骤自动运转，把时间留给更有价值的创造。\",\"value\":\"03\",\"icon\":\"zap\"},{\"label\":\"看见结果\",\"description\":\"每个环节透明可见，让想法真正变成可交付的成果。\",\"value\":\"04\",\"icon\":\"chart\"}]}",
      "update": "reload"
    },
    {
      "id": "speed",
      "label": "动画速度",
      "type": "number",
      "default": 1,
      "min": 0.3,
      "max": 2.5,
      "step": 0.1,
      "update": "reload"
    },
    {
      "id": "hold",
      "label": "每项停留",
      "type": "number",
      "default": 5,
      "min": 3,
      "max": 10,
      "step": 0.5,
      "update": "reload"
    },
    {
      "id": "depth",
      "label": "空间层距",
      "type": "number",
      "default": 1,
      "min": 0.6,
      "max": 1.3,
      "step": 0.05,
      "update": "reload"
    },
    {
      "id": "textSpeed",
      "label": "出字速度",
      "type": "number",
      "default": 1,
      "min": 0.4,
      "max": 2.5,
      "step": 0.1,
      "update": "reload"
    },
    {
      "id": "cycle",
      "label": "自动轮转",
      "type": "boolean",
      "default": true,
      "update": "reload"
    },
    {
      "id": "active",
      "label": "固定聚焦项",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 7,
      "step": 1,
      "update": "reload"
    },
    {
      "id": "glow",
      "label": "辉光强度",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1.5,
      "step": 0.1,
      "update": "reload"
    },
    {
      "id": "labels",
      "label": "显示节点名称",
      "type": "boolean",
      "default": true,
      "update": "reload"
    },
    {
      "id": "grid",
      "label": "背景网格",
      "type": "boolean",
      "default": true,
      "update": "reload"
    }
  ],
  "source": {
    "provider": "ipollowork-local-import",
    "label": "iPolloWork reusable components"
  }
}
