{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "spain-map",
  "type": "hyperframes:block",
  "librarySection": "interface-animation",
  "title": "Spain Map",
  "description": "Animated Spain choropleth by autonomous community with staggered reveals and gradient legend — D3 conic conformal projection",
  "tags": ["component", "data", "map", "geography", "spain", "europe", "choropleth", "theme"],
  "version": "1.0.0", "author": "iPolloWork", "license": "Apache-2.0",
  "source": { "provider": "HyperFrames", "label": "Spain Map", "url": "https://www.hyperframes.dev/catalog/blocks/spain-map" },
  "visualComponent": { "version": 1, "category": "maps", "surfaces": ["video"], "themeMode": "inherit", "ai": { "slots": ["title", "values", "highlight", "source"], "instructions": "AI may replace regional values or add a short annotation, but must retain valid region abbreviations and map legibility." } },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "variables": [
    { "id": "title", "label": "Title", "type": "string", "default": "PIB per cápita por Comunidad Autónoma", "maxLength": 76, "update": "live" },
    { "id": "values", "label": "Regional data", "description": "Comma-separated ABBR:Value pairs.", "type": "string", "default": "MAD:38100,PVA:36800,NAV:35200,CAT:33700,AND:20200", "maxLength": 180, "update": "live" },
    { "id": "highlight", "label": "Highlight", "type": "string", "default": "MAD", "maxLength": 8, "update": "live" },
    { "id": "source", "label": "Source", "type": "string", "default": "Fuente: Instituto Nacional de Estadística", "maxLength": 72, "update": "live" }
  ],
  "files": [
    {
      "path": "spain-map.html",
      "target": "compositions/spain-map.html",
      "type": "hyperframes:composition"
    }
  ],
  "preview": {
    "video": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/blocks/spain-map.mp4",
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/blocks/spain-map.png"
  }
}
