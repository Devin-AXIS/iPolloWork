{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "opening-prism-sweep",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Prism Sweep",
  "description": "A luminous prism sweeps across the frame, separating color before revealing a sharp cinematic title.",
  "kind": "effect",
  "librarySection": "opening-animation",
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 4.4,
  "tags": ["opening", "prism", "light", "cinematic", "optical"],
  "engine": { "name": "gsap", "version": "3.15.0", "seekable": true, "plugins": [] },
  "source": { "provider": "ipollowork", "label": "iPolloWork Motion Library" },
  "motionPreset": {
    "version": 1,
    "category": "opening",
    "targets": ["any", "text", "image", "shape", "group"],
    "anchor": "clip-start",
    "duration": 1.1,
    "ease": "power3.out",
    "keyframes": [
      {
        "percentage": 0,
        "properties": { "opacity": 0, "xPercent": -24, "scale": 1.08, "filter": "blur(18px)" }
      },
      {
        "percentage": 64,
        "properties": { "opacity": 1, "xPercent": 1, "scale": 1, "filter": "blur(0px)" }
      },
      {
        "percentage": 100,
        "properties": { "opacity": 1, "xPercent": 0, "scale": 1, "filter": "blur(0px)" }
      }
    ]
  },
  "files": [
    {
      "path": "opening-prism-sweep.html",
      "target": "compositions/opening-prism-sweep.html",
      "type": "hyperframes:composition"
    }
  ]
}
