{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "us-map-bubble",
  "type": "hyperframes:block",
  "librarySection": "interface-animation",
  "title": "US Bubble Map",
  "description": "Animated US bubble map with proportional city markers, value callouts, and connection lines — composable with us-map",
  "tags": ["component", "data", "map", "geography", "usa", "bubble", "cities", "theme"],
  "version": "1.0.0", "author": "iPolloWork", "license": "Apache-2.0",
  "source": { "provider": "HyperFrames", "label": "US Bubble Map", "url": "https://www.hyperframes.dev/catalog/blocks/us-map-bubble" },
  "visualComponent": { "version": 1, "category": "maps", "surfaces": ["video"], "themeMode": "inherit", "ai": { "slots": ["title", "cities", "highlight", "source"], "instructions": "AI may replace city values or annotate the highlighted city while retaining valid city names and proportional bubbles." } },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "variables": [
    { "id": "title", "label": "Title", "type": "string", "default": "Top US Cities by Population", "maxLength": 72, "update": "live" },
    { "id": "cities", "label": "City data", "description": "Comma-separated City:Value pairs.", "type": "string", "default": "New York:8300000,Los Angeles:3900000,Chicago:2700000,Houston:2300000", "maxLength": 220, "update": "live" },
    { "id": "highlight", "label": "Highlight", "type": "string", "default": "New York", "maxLength": 32, "update": "live" },
    { "id": "source", "label": "Source", "type": "string", "default": "Source: U.S. Census Bureau, 2024", "maxLength": 72, "update": "live" }
  ],
  "files": [
    {
      "path": "us-map-bubble.html",
      "target": "compositions/us-map-bubble.html",
      "type": "hyperframes:composition"
    }
  ],
  "preview": {
    "video": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/blocks/us-map-bubble.mp4",
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/blocks/us-map-bubble.png"
  }
}
