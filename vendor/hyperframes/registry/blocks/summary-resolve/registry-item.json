{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "summary-resolve",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Summary Resolve",
  "description": "Close an explainer by resolving its core argument.",
  "tags": [
    "component",
    "scene",
    "split",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "scene",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four summary points. Keep pipe separators between items and preserve the split layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "summary-resolve.html",
      "target": "compositions/summary-resolve.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Summary Resolve",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Signal::What changed|Meaning::Why it matters|Action::What to do next|Proof::How we know",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "End with a decision, not a fade",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
