{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "shotcraft-outline-word-fill",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "描边关键词填充",
  "description": "描边关键词填充，保留转换版原动作并支持旁白事件绑定。",
  "tags": [
    "component",
    "shotcraft",
    "typography",
    "theme"
  ],
  "author": "Wei Yihao; louiseliu HyperFrames conversion; iPolloWork integration",
  "license": "Apache-2.0",
  "upstream": {
    "repository": "https://github.com/louiseliu/hyperFrames-video-shotcraft",
    "revision": "1df77f1ab080323558f70a5fb880fad0f88f87fc",
    "implementation": "demos/typography/outline-word-fill/index.html",
    "rules": "references/shots/typography/outline-word-fill.md",
    "license": "Apache-2.0",
    "upstreamSha256": "1c9ef285442105fc83f7f1912bb9904881aaff954c85691cab78f158cc09ed4b",
    "adaptation": "Preserves the converted HTML/GSAP source. Modified: editable escaped content, measured phase cues, explicit canvas, final hold and iPolloWork contracts. No generic replacement animation.",
    "referenceGallery": "https://github.com/louiseliu/hyperFrames-video-shotcraft/tree/1df77f1ab080323558f70a5fb880fad0f88f87fc/gallery"
  },
  "source": {
    "provider": "hyperframes-video-shotcraft",
    "label": "HyperFrames Shotcraft · Apache-2.0",
    "url": "https://github.com/louiseliu/hyperFrames-video-shotcraft/blob/1df77f1ab080323558f70a5fb880fad0f88f87fc/references/shots/typography/outline-word-fill.md"
  },
  "visualComponent": {
    "version": 1,
    "category": "typography",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title"
      ],
      "instructions": "把一个短关键词从轮廓填充为明确强调。"
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 4,
  "engine": {
    "name": "gsap",
    "version": "3.14.2",
    "seekable": true
  },
  "files": [
    {
      "path": "shotcraft-outline-word-fill.html",
      "target": "compositions/shotcraft-outline-word-fill.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "LICENSE",
      "target": "compositions/licenses/hyperframes-video-shotcraft-LICENSE.txt",
      "type": "hyperframes:asset"
    },
    {
      "path": "recipe.md",
      "target": "compositions/shotcraft-outline-word-fill.recipe.md",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "title",
      "type": "string",
      "default": "机制",
      "maxLength": 6,
      "update": "reload"
    },
    {
      "id": "motionCueTimes",
      "label": "Measured phase cue times",
      "type": "string",
      "default": "{}",
      "maxLength": 2048,
      "update": "reload"
    }
  ],
  "motionRecipe": {
    "version": 1,
    "pattern": "kinetic-type",
    "minHoldSeconds": 0.7,
    "textLimits": {
      "title": {
        "maxLines": 1,
        "maxLineLength": 6
      }
    },
    "events": [
      {
        "id": "phase-1",
        "target": ".sc-content *",
        "time": 0.65,
        "duration": 1.65,
        "action": "建立描边关键词与焦点"
      },
      {
        "id": "phase-2",
        "target": ".sc-content *",
        "time": 2.3,
        "duration": 0.8500000000000001,
        "action": "填充关键词完成强调"
      }
    ],
    "usage": {
      "useWhen": [
        "把一个短关键词从轮廓填充为明确强调。"
      ],
      "avoidWhen": [
        "不用于完整解释、前后数值变化或表示任务已完成；填色本身不是状态验证。",
        "不要把文字特效当作全场景内容；避免与运镜或另一强调动作同时争抢焦点。"
      ],
      "inputRules": {
        "title": "一个待强调关键词，单行最多6字；填充不编码数量、完成状态或好坏评价。"
      },
      "readingOrder": [
        "建立词的轮廓",
        "填充当前强调词",
        "保留实心词的可读状态"
      ],
      "cueBindings": {
        "phase-1": "绑定实测旁白中与“建立描边关键词与焦点”对应的精确短语；保持该段原曲线。",
        "phase-2": "绑定实测旁白中与“填充关键词完成强调”对应的精确短语；保持该段原曲线。"
      },
      "fallback": {
        "overflow": "拆分语义或选择其他配方，不缩小文字或截断。",
        "missingInput": "要求真实内容，不使用英文演示文案或虚构界面。",
        "timingMismatch": "重新绑定实测短语；内部动作比例不变，超长旁白拆镜。",
        "inapplicable": "选择合适配方；仅配方模式下报告库缺口，不临时绘制替代图形。"
      },
      "example": {
        "values": {
          "title": "机制"
        },
        "narration": "机制。"
      },
      "acceptance": [
        "填充强调的是当前发声关键词，而不是无证据的完成或改善状态。",
        "原始 GSAP / 逐帧函数真实执行，倒放复现同一画面。",
        "每个绑定事件改变实际目标，结束文字完整且可读。",
        "以实际字体和中文内容检查安全边界；不复用演示身份与假素材。"
      ],
      "intent": "将当前关键词由轮廓填实，让观众在说到它时完成一次语义聚焦。"
    }
  }
}
