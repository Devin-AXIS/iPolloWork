{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "checklist-reveal",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Checklist Reveal",
  "description": "Turn a practical checklist into a satisfying sequence.",
  "tags": [
    "component",
    "typography",
    "steps",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "typography",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four checklist rows. Keep pipe separators between items and preserve the steps layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "checklist-reveal.html",
      "target": "compositions/checklist-reveal.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Checklist Reveal",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "✓::Brief locked|✓::Theme applied|✓::Motion checked|✓::Export verified",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Four checks before delivery",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
