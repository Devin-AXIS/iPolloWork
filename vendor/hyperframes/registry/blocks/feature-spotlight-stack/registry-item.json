{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "feature-spotlight-stack",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Feature Spotlight Stack",
  "description": "Stage product benefits as a focused vertical stack.",
  "tags": [
    "component",
    "product",
    "stack",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "product",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four feature cards. Keep pipe separators between items and preserve the stack layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "feature-spotlight-stack.html",
      "target": "compositions/feature-spotlight-stack.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Feature Spotlight Stack",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Capture::Bring context in|Compose::Shape the output|Review::Keep control|Share::Move work forward",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Four moments in one product flow",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
