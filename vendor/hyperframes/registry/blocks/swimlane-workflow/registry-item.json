{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "swimlane-workflow",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Swimlane Workflow",
  "description": "Show responsibility moving across a multi-role workflow.",
  "tags": [
    "component",
    "diagrams",
    "lanes",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "diagrams",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four role lanes. Keep pipe separators between items and preserve the lanes layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "swimlane-workflow.html",
      "target": "compositions/swimlane-workflow.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Swimlane Workflow",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "You::Set intent|Agent::Draft output|Reviewer::Approve|System::Deliver",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "One handoff per lane",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
