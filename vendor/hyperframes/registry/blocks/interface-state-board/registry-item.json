{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "interface-state-board",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Interface State Board",
  "description": "Compare important UI states before a walkthrough.",
  "tags": [
    "component",
    "media",
    "cards",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "media",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four interface states. Keep pipe separators between items and preserve the cards layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "interface-state-board.html",
      "target": "compositions/interface-state-board.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Interface State Board",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "EMPTY::Invite first action|LOADING::Confirm progress|SUCCESS::Show the result|ERROR::Offer recovery",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A state model for product storytelling",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
