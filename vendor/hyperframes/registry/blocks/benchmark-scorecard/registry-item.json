{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "benchmark-scorecard",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Benchmark Scorecard",
  "description": "Compare performance against clear benchmarks.",
  "tags": [
    "component",
    "proof",
    "dashboard",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "proof",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four benchmark meters. Keep pipe separators between items and preserve the dashboard layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "benchmark-scorecard.html",
      "target": "compositions/benchmark-scorecard.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Benchmark Scorecard",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Response::1.8× faster|Accuracy::+14 points|Handoffs::-38%|Adoption::86%",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Measured against the previous workflow",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
