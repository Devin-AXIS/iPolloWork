{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "terminal-command-sequence",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Terminal Command Sequence",
  "description": "Explain a command workflow without exposing a full terminal log.",
  "tags": [
    "component",
    "developer",
    "lanes",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "developer",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four command steps. Keep pipe separators between items and preserve the lanes layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "terminal-command-sequence.html",
      "target": "compositions/terminal-command-sequence.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Terminal Command Sequence",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "init::Create project|check::Validate composition|snapshot::Inspect frames|render::Produce video",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Commands presented as a reproducible sequence",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
