{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "cohort-retention",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Cohort Retention",
  "description": "Show retention patterns across a compact cohort matrix.",
  "tags": [
    "component",
    "data",
    "matrix",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "data",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four cohort cells. Keep pipe separators between items and preserve the matrix layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "cohort-retention.html",
      "target": "compositions/cohort-retention.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Cohort Retention",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Jan::92 · 81 · 74|Feb::94 · 84 · 77|Mar::91 · 86 · 79|Apr::96 · 89 · 82",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Four cohorts across three return periods",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
