{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "process-handoff-map",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Process Handoff Map",
  "description": "Show the critical handoffs in a delivery process.",
  "tags": [
    "component",
    "diagrams",
    "flow",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "diagrams",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four handoff stages. Keep pipe separators between items and preserve the flow layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "process-handoff-map.html",
      "target": "compositions/process-handoff-map.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Process Handoff Map",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Brief→Design::Intent|Design→Build::Specification|Build→Review::Evidence|Review→Ship::Approval",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A stable process protects every handoff",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
