{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "campaign-metric-hero",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Campaign Metric Hero",
  "description": "Pair a campaign idea with its primary success measures.",
  "tags": [
    "component",
    "brand",
    "dashboard",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "brand",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four campaign metrics. Keep pipe separators between items and preserve the dashboard layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "campaign-metric-hero.html",
      "target": "compositions/campaign-metric-hero.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Campaign Metric Hero",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Reach::4.2M|Completion::68%|Saves::142K|Lift::+18%",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A campaign idea with evidence attached",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
