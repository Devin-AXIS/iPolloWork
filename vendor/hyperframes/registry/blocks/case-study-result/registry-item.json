{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "case-study-result",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Case Study Result",
  "description": "Connect a customer problem directly to a measurable result.",
  "tags": [
    "component",
    "proof",
    "split",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "proof",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four before and result panels. Keep pipe separators between items and preserve the split layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "case-study-result.html",
      "target": "compositions/case-study-result.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Case Study Result",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Before::4 tools per task|After::1 reviewed flow|Result::42% faster|Proof::Team study",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "From scattered work to one visible outcome",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
