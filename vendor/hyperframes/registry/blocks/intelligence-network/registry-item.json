{
  "name": "intelligence-network",
  "type": "hyperframes:block",
  "title": "智能网络轮转台",
  "description": "立体分区圆盘、旋转聚焦、扫描光束与逐字说明。适合能力地图和产品模块讲解。",
  "version": "1.0.0",
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "tags": [
    "component",
    "diagrams",
    "isometric",
    "theme",
    "讲解",
    "宣传"
  ],
  "visualComponent": {
    "version": 1,
    "category": "diagrams",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "data": {
      "version": 1,
      "kind": "category-value",
      "mode": "replace",
      "rowId": "label",
      "binding": {
        "variable": "nodes",
        "encoding": "json"
      },
      "columns": [
        {
          "id": "label",
          "label": "Name",
          "labelZh": "名称",
          "type": "string",
          "role": "label",
          "required": true
        },
        {
          "id": "icon",
          "label": "Icon",
          "labelZh": "图标",
          "type": "string",
          "role": "value",
          "options": [
            {
              "value": "workflow",
              "label": "工作流"
            },
            {
              "value": "settings",
              "label": "设置"
            },
            {
              "value": "zap",
              "label": "闪电"
            },
            {
              "value": "layers",
              "label": "图层"
            },
            {
              "value": "brain",
              "label": "智能"
            },
            {
              "value": "database",
              "label": "数据库"
            },
            {
              "value": "bot",
              "label": "机器人"
            },
            {
              "value": "globe",
              "label": "全球"
            },
            {
              "value": "cpu",
              "label": "算力"
            },
            {
              "value": "chart",
              "label": "分析"
            },
            {
              "value": "mail",
              "label": "消息"
            },
            {
              "value": "code",
              "label": "代码"
            }
          ]
        },
        {
          "id": "description",
          "label": "Description",
          "labelZh": "讲解内容",
          "type": "string",
          "role": "value"
        },
        {
          "id": "image",
          "label": "Custom icon",
          "labelZh": "自定义图标",
          "type": "string",
          "role": "value",
          "format": "image"
        }
      ],
      "minRows": 2,
      "maxRows": 12
    },
    "ai": {
      "slots": [
        "centerLabel",
        "nodes",
        "speed",
        "tilt",
        "radius",
        "nodeScale",
        "textSpeed",
        "cycle",
        "active",
        "rotationSpeed",
        "beamHeight",
        "glow",
        "labels",
        "grid"
      ],
      "instructions": "Edit native variables and structured node rows; do not rewrite the drawing. Icon is a provided enum or embedded image. Node count is the number of rows. Theme colors and typography inherit from the project. Playback is deterministic and owned by the host timeline."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 30,
  "engine": {
    "name": "gsap",
    "version": "3.14.2",
    "seekable": true
  },
  "files": [
    {
      "path": "intelligence-network.html",
      "target": "compositions/intelligence-network/intelligence-network.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "gsap.min.js",
      "target": "compositions/intelligence-network/gsap.min.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "NOTICE",
      "target": "compositions/intelligence-network/NOTICE",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "centerLabel",
      "label": "中心标题",
      "type": "string",
      "default": "NETWORK\nCORE",
      "maxLength": 60,
      "update": "reload"
    },
    {
      "id": "nodes",
      "label": "节点 / 内容",
      "type": "string",
      "default": "{\"version\":1,\"kind\":\"category-value\",\"rows\":[{\"label\":\"Automate\",\"icon\":\"settings\",\"description\":\"把重复的工作，交给自动化流程。\"},{\"label\":\"Connect\",\"icon\":\"globe\",\"description\":\"连接应用与资源，保持网络实时同步。\"},{\"label\":\"Create\",\"icon\":\"brain\",\"description\":\"从一个想法出发，释放创作能力。\"},{\"label\":\"Compute\",\"icon\":\"cpu\",\"description\":\"用计算与推理，推动复杂任务执行。\"},{\"label\":\"Insight Node\",\"icon\":\"database\",\"description\":\"将分散的数据，转化为清晰的决策洞察。\"},{\"label\":\"Deliver\",\"icon\":\"zap\",\"description\":\"让每一次决策，都抵达真正的结果。\"}]}",
      "update": "reload"
    },
    {
      "id": "speed",
      "label": "动画速度",
      "type": "number",
      "default": 1,
      "min": 0.3,
      "max": 2.5,
      "step": 0.1,
      "update": "reload"
    },
    {
      "id": "tilt",
      "label": "透视倾角",
      "type": "number",
      "default": 0.51,
      "min": 0.44,
      "max": 0.86,
      "step": 0.01,
      "update": "reload"
    },
    {
      "id": "radius",
      "label": "排列半径",
      "type": "number",
      "default": 322,
      "min": 270,
      "max": 360,
      "step": 1,
      "update": "reload"
    },
    {
      "id": "nodeScale",
      "label": "图标尺寸",
      "type": "number",
      "default": 1,
      "min": 0.72,
      "max": 1.15,
      "step": 0.01,
      "update": "reload"
    },
    {
      "id": "textSpeed",
      "label": "出字速度",
      "type": "number",
      "default": 1,
      "min": 0.4,
      "max": 2.5,
      "step": 0.1,
      "update": "reload"
    },
    {
      "id": "cycle",
      "label": "自动轮转",
      "type": "boolean",
      "default": true,
      "update": "reload"
    },
    {
      "id": "active",
      "label": "固定聚焦项",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 11,
      "step": 1,
      "update": "reload"
    },
    {
      "id": "rotationSpeed",
      "label": "轮转速度",
      "type": "number",
      "default": 1,
      "min": 0.4,
      "max": 2.5,
      "step": 0.1,
      "update": "reload"
    },
    {
      "id": "beamHeight",
      "label": "光束高度",
      "type": "number",
      "default": 188,
      "min": 90,
      "max": 270,
      "step": 1,
      "update": "reload"
    },
    {
      "id": "glow",
      "label": "辉光强度",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1.5,
      "step": 0.1,
      "update": "reload"
    },
    {
      "id": "labels",
      "label": "显示节点名称",
      "type": "boolean",
      "default": true,
      "update": "reload"
    },
    {
      "id": "grid",
      "label": "背景网格",
      "type": "boolean",
      "default": true,
      "update": "reload"
    }
  ],
  "source": {
    "provider": "ipollowork-local-import",
    "label": "iPolloWork reusable components"
  }
}
