{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "product-benefit-orbit",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Product Benefit Orbit",
  "description": "Connect product benefits to one central promise.",
  "tags": [
    "component",
    "product",
    "orbit",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "product",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four benefit nodes. Keep pipe separators between items and preserve the orbit layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "product-benefit-orbit.html",
      "target": "compositions/product-benefit-orbit.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Product Benefit Orbit",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Faster::Less setup|Clearer::Visible context|Safer::Review gates|Reusable::Repeatable systems",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Benefits orbit one customer outcome",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
