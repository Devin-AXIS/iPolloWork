{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "dependency-graph",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Dependency Graph",
  "description": "Show which inputs unlock a final deliverable.",
  "tags": [
    "component",
    "diagrams",
    "network",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "diagrams",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four dependency nodes. Keep pipe separators between items and preserve the network layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "dependency-graph.html",
      "target": "compositions/dependency-graph.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Dependency Graph",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Brief::Required|Assets::Required|Theme::Shared|Export::Unlocked",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "The output is only as stable as its dependencies",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
