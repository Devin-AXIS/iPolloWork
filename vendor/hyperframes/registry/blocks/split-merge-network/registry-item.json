{
  "name": "split-merge-network",
  "type": "hyperframes:block",
  "title": "分支与汇合",
  "description": "薄板节点与精细连线构成的分流、并行处理和汇合动画。2–8 个可编辑分支，可换图标或图片，适合架构、AI 协作、教育与商业流程。",
  "version": "1.1.0",
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "tags": [
    "component",
    "diagrams",
    "isometric",
    "parallel",
    "split",
    "merge",
    "theme",
    "分支",
    "汇合",
    "协作"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 18,
  "engine": {
    "name": "gsap",
    "version": "3.14.2",
    "seekable": true
  },
  "visualComponent": {
    "version": 1,
    "category": "diagrams",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "data": {
      "version": 1,
      "kind": "category-value",
      "mode": "replace",
      "rowId": "label",
      "binding": {
        "variable": "branches",
        "encoding": "json"
      },
      "minRows": 2,
      "maxRows": 8,
      "columns": [
        {
          "id": "label",
          "label": "Name",
          "labelZh": "名称",
          "type": "string",
          "role": "label",
          "required": true
        },
        {
          "id": "description",
          "label": "Explanation",
          "labelZh": "讲解说明",
          "type": "string",
          "role": "value"
        },
        {
          "id": "icon",
          "label": "Icon",
          "labelZh": "图标",
          "type": "string",
          "role": "value",
          "options": [
            {
              "value": "workflow",
              "label": "工作流"
            },
            {
              "value": "settings",
              "label": "设置"
            },
            {
              "value": "zap",
              "label": "闪电"
            },
            {
              "value": "layers",
              "label": "图层"
            },
            {
              "value": "brain",
              "label": "智能"
            },
            {
              "value": "database",
              "label": "数据库"
            },
            {
              "value": "bot",
              "label": "机器人"
            },
            {
              "value": "globe",
              "label": "全球"
            },
            {
              "value": "cpu",
              "label": "算力"
            },
            {
              "value": "chart",
              "label": "分析"
            },
            {
              "value": "mail",
              "label": "消息"
            },
            {
              "value": "code",
              "label": "代码"
            }
          ]
        },
        {
          "id": "image",
          "label": "Custom icon",
          "labelZh": "自定义图标",
          "type": "string",
          "role": "value",
          "format": "image"
        }
      ]
    },
    "ai": {
      "slots": [
        "branches",
        "inputLabel",
        "inputIcon",
        "outputLabel",
        "outputIcon",
        "speed",
        "spread",
        "nodeScale",
        "tilt",
        "glow",
        "labels",
        "explanations",
        "inputDescription",
        "outputDescription",
        "motion",
        "grid",
        "background"
      ],
      "instructions": "Use native variables and branch rows. Each branch has a short label, icon and explanation. All branches process in parallel; the spotlight explains each branch in turn, then the results merge. Set labels and explanations false for a pure graphic beside external copy. Colors and typography inherit the host design system. Text, signals and plate motion share one seekable host timeline; do not rewrite the composition."
    }
  },
  "variables": [
    {
      "id": "branches",
      "label": "分支节点",
      "type": "string",
      "default": "{\"version\":1,\"kind\":\"category-value\",\"rows\":[{\"label\":\"研究\",\"icon\":\"brain\",\"image\":\"\",\"description\":\"收集资料、识别关键问题，为后续创作提供依据。\"},{\"label\":\"创作\",\"icon\":\"code\",\"image\":\"\",\"description\":\"根据目标与资料制作内容，把想法转化为可用成果。\"},{\"label\":\"审核\",\"icon\":\"settings\",\"image\":\"\",\"description\":\"检查质量、事实与规范，让各个分支的成果保持一致。\"}]}",
      "update": "reload"
    },
    {
      "id": "inputLabel",
      "label": "输入名称",
      "type": "string",
      "default": "任务输入",
      "update": "reload",
      "maxLength": 24
    },
    {
      "id": "inputIcon",
      "label": "输入图标",
      "type": "enum",
      "default": "layers",
      "update": "reload",
      "options": [
        {
          "value": "workflow",
          "label": "工作流"
        },
        {
          "value": "settings",
          "label": "设置"
        },
        {
          "value": "zap",
          "label": "闪电"
        },
