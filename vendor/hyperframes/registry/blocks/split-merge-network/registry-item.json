        },
        {
          "value": "globe",
          "label": "全球"
        },
        {
          "value": "cpu",
          "label": "算力"
        },
        {
          "value": "chart",
          "label": "分析"
        },
        {
          "value": "mail",
          "label": "消息"
        },
        {
          "value": "code",
          "label": "代码"
        }
      ]
    },
    {
      "id": "outputLabel",
      "label": "输出名称",
      "type": "string",
      "default": "成果汇合",
      "update": "reload",
      "maxLength": 24
    },
    {
      "id": "outputIcon",
      "label": "输出图标",
      "type": "enum",
      "default": "zap",
      "update": "reload",
      "options": [
        {
          "value": "workflow",
          "label": "工作流"
        },
        {
          "value": "settings",
          "label": "设置"
        },
        {
          "value": "zap",
          "label": "闪电"
        },
        {
          "value": "layers",
          "label": "图层"
        },
        {
          "value": "brain",
          "label": "智能"
        },
        {
          "value": "database",
          "label": "数据库"
        },
        {
          "value": "bot",
          "label": "机器人"
        },
        {
          "value": "globe",
          "label": "全球"
        },
        {
          "value": "cpu",
          "label": "算力"
        },
        {
          "value": "chart",
          "label": "分析"
        },
        {
          "value": "mail",
          "label": "消息"
        },
        {
          "value": "code",
          "label": "代码"
        }
      ]
    },
    {
      "id": "speed",
      "label": "动画速度",
      "type": "number",
      "default": 1,
      "update": "reload",
      "min": 0.3,
      "max": 2.5,
      "step": 0.1
    },
    {
      "id": "spread",
      "label": "分支间距",
      "type": "number",
      "default": 1,
      "update": "reload",
      "min": 0.6,
      "max": 1.2,
      "step": 0.05
    },
    {
      "id": "nodeScale",
      "label": "节点大小",
      "type": "number",
      "default": 1,
      "update": "reload",
      "min": 0.65,
      "max": 1.15,
      "step": 0.05
    },
    {
      "id": "tilt",
      "label": "透视倾角",
      "type": "number",
      "default": 0.56,
      "update": "reload",
      "min": 0.4,
      "max": 0.8,
      "step": 0.02
    },
    {
      "id": "glow",
      "label": "流光强度",
      "type": "number",
      "default": 0.7,
      "update": "reload",
      "min": 0,
      "max": 1.5,
      "step": 0.1
    },
    {
      "id": "labels",
      "label": "显示节点名称",
      "type": "boolean",
      "default": true,
      "update": "reload"
    },
    {
      "id": "explanations",
      "label": "显示动画讲解",
      "type": "boolean",
      "default": true,
      "update": "reload"
    },
    {
      "id": "inputDescription",
      "label": "输入说明",
      "type": "string",
      "default": "把一个目标拆分给多个分支，让专业能力并行协作。",
      "update": "reload",
      "maxLength": 140
    },
    {
      "id": "outputDescription",
      "label": "汇合说明",
      "type": "string",
      "default": "汇集各个分支的结果，形成一份完整、可交付的成果。",
      "update": "reload",
      "maxLength": 140
    },
    {
      "id": "motion",
      "label": "动感强度",
      "type": "number",
      "default": 1,
      "update": "reload",
      "min": 0,
      "max": 2,
      "step": 0.1
    },
    {
      "id": "grid",
      "label": "显示背景网格",
      "type": "boolean",
      "default": true,
      "update": "reload"
    },
    {
      "id": "background",
      "label": "显示背景底色",
      "type": "boolean",
      "default": false,
      "update": "reload"
    }
  ],
