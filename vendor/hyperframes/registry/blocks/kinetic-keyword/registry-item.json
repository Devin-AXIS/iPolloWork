{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "kinetic-keyword",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Kinetic Keyword",
  "description": "Build a text-first beat around one decisive keyword.",
  "tags": [
    "component",
    "typography",
    "editorial",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "typography",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four oversized keyword. Keep pipe separators between items and preserve the editorial layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "kinetic-keyword.html",
      "target": "compositions/kinetic-keyword.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Kinetic Keyword",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "CLARITY::See the work|CONTROL::Shape the result|MOMENTUM::Keep moving|TRUST::Review every step",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "One word carries the scene",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
