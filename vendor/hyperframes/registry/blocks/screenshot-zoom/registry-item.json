{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "screenshot-zoom",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Screenshot Zoom",
  "description": "Frame a product screenshot and call attention to one area.",
  "tags": [
    "component",
    "media",
    "frame",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "media",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four interface frame. Keep pipe separators between items and preserve the frame layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "screenshot-zoom.html",
      "target": "compositions/screenshot-zoom.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Screenshot Zoom",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Canvas::Main workspace|Inspector::Safe controls|Timeline::Precise timing|Export::Ready output",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Focus the viewer before explaining the detail",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
