{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "opening-editorial-rise",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Editorial Rise",
  "description": "Oversized editorial typography rises through a restrained mask and resolves into a magazine-like opening frame.",
  "kind": "animation",
  "librarySection": "opening-animation",
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 4.6,
  "tags": ["opening", "editorial", "typography", "mask", "minimal"],
  "engine": { "name": "gsap", "version": "3.15.0", "seekable": true, "plugins": [] },
  "source": { "provider": "ipollowork", "label": "iPolloWork Motion Library" },
  "motionPreset": {
    "version": 1,
    "category": "opening",
    "targets": ["any", "text", "image", "shape", "group"],
    "anchor": "clip-start",
    "duration": 1.05,
    "ease": "power4.out",
    "keyframes": [
      {
        "percentage": 0,
        "properties": { "opacity": 0, "yPercent": 115, "clipPath": "inset(0 0 100% 0)" }
      },
      {
        "percentage": 72,
        "properties": { "opacity": 1, "yPercent": 0, "clipPath": "inset(0 0 0% 0)" }
      },
      {
        "percentage": 100,
        "properties": { "opacity": 1, "yPercent": 0, "clipPath": "inset(0 0 0% 0)" }
      }
    ]
  },
  "files": [
    {
      "path": "opening-editorial-rise.html",
      "target": "compositions/opening-editorial-rise.html",
      "type": "hyperframes:composition"
    }
  ]
}
