{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "api-request-flow",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "API Request Flow",
  "description": "Explain an API request from client through response.",
  "tags": [
    "component",
    "developer",
    "lanes",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "developer",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four request stages. Keep pipe separators between items and preserve the lanes layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "api-request-flow.html",
      "target": "compositions/api-request-flow.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "API Request Flow",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Client::POST /render|Server::Validate input|Worker::Build frames|Response::Return artifact",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A request stays traceable end to end",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
