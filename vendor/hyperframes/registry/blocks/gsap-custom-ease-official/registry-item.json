{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "gsap-custom-ease-official",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "kind": "effect",
  "librarySection": "background-scene",
  "title": "CustomEase Official Demo",
  "description": "Official GSAP CustomEase capability adapted as a seekable iPolloWork effect.",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 6,
  "tags": [
    "effect",
    "gsap-official",
    "ease"
  ],
  "engine": {
    "name": "gsap",
    "version": "3.15.0",
    "seekable": true,
    "plugins": [
      "CustomEase"
    ]
  },
  "source": {
    "provider": "gsap-docs",
    "label": "GSAP 3.15.0 Docs",
    "url": "https://gsap.com/docs/v3/Eases/CustomEase/"
  },
  "files": [
    {
      "path": "gsap-custom-ease-official.html",
      "target": "compositions/gsap-custom-ease-official.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "headline",
      "label": "Headline",
      "type": "string",
      "default": "CustomEase Official Demo",
      "maxLength": 80,
      "update": "reload"
    },
    {
      "id": "backgroundColor",
      "label": "Background color",
      "type": "color",
      "default": "#070B16",
      "update": "live"
    },
    {
      "id": "accentColor",
      "label": "Accent color",
      "type": "color",
      "default": "#6EF2BE",
      "update": "live"
    },
    {
      "id": "intensity",
      "label": "Intensity",
      "type": "number",
      "default": 1,
      "min": 0.25,
      "max": 2,
      "step": 0.05,
      "update": "rebuild"
    },
    {
      "id": "duration",
      "label": "Duration",
      "type": "number",
      "default": 6,
      "min": 1,
      "max": 20,
      "step": 0.5,
      "unit": "s",
      "update": "rebuild"
    }
  ],
  "agentPrompt": "Use the CustomEase official GSAP capability. Preserve its declared variables, source credit, and deterministic seek contract."
}
