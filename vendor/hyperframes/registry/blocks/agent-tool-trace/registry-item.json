{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "agent-tool-trace",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Agent Tool Trace",
  "description": "Visualize how an agent selects and invokes tools.",
  "tags": [
    "component",
    "developer",
    "network",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "developer",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four agent and tool nodes. Keep pipe separators between items and preserve the network layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "agent-tool-trace.html",
      "target": "compositions/agent-tool-trace.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Agent Tool Trace",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Prompt::Intent|Search::Evidence|Editor::Artifact|Check::Proof",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Every tool call has a visible purpose",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
