{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "caption-phrase-lift",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Phrase Lift",
  "description": "Readable caption phrases lift through a soft blur, settle quickly, and preserve a calm spoken rhythm.",
  "kind": "effect",
  "librarySection": "caption-animation",
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 4.2,
  "tags": ["caption", "captions", "phrase", "subtitle", "editorial"],
  "engine": { "name": "gsap", "version": "3.15.0", "seekable": true, "plugins": [] },
  "source": { "provider": "ipollowork", "label": "iPolloWork Motion Library" },
  "motionPreset": {
    "version": 1,
    "category": "caption",
    "targets": ["caption", "text"],
    "anchor": "clip-start",
    "duration": 0.72,
    "ease": "power3.out",
    "keyframes": [
      {
        "percentage": 0,
        "properties": { "opacity": 0, "y": 34, "scale": 0.97, "filter": "blur(8px)" }
      },
      {
        "percentage": 68,
        "properties": { "opacity": 1, "y": 0, "scale": 1.012, "filter": "blur(0px)" }
      },
      {
        "percentage": 100,
        "properties": { "opacity": 1, "y": 0, "scale": 1, "filter": "blur(0px)" }
      }
    ]
  },
  "files": [
    {
      "path": "caption-phrase-lift.html",
      "target": "compositions/caption-phrase-lift.html",
      "type": "hyperframes:composition"
    }
  ]
}
