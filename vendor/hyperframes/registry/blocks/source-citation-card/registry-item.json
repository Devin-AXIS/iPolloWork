{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "source-citation-card",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Source Citation Card",
  "description": "Present a claim together with a clear source citation.",
  "tags": [
    "component",
    "proof",
    "split",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "proof",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four claim and citation. Keep pipe separators between items and preserve the split layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "source-citation-card.html",
      "target": "compositions/source-citation-card.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Source Citation Card",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Claim::Teams review earlier|Source::Workflow study 2026|Sample::42 projects|Confidence::High",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Evidence stays attached to the statement",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
