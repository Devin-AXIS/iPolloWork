{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "brand-manifesto",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Brand Manifesto",
  "description": "Turn a brand belief into a strong editorial statement.",
  "tags": [
    "component",
    "brand",
    "spotlight",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "brand",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four manifesto lines. Keep pipe separators between items and preserve the spotlight layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "brand-manifesto.html",
      "target": "compositions/brand-manifesto.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Brand Manifesto",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Believe::Work should stay understandable|Build::Tools should feel human|Protect::Users keep control|Prove::Outcomes stay visible",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A brand is a promise repeated in practice",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
