{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "ranking-list",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Ranking List",
  "description": "An ordered data list with proportional bars, a highlighted entry and structured row editing.",
  "tags": ["component", "structured", "ranking", "data", "theme"],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "data",
    "surfaces": ["video"],
    "themeMode": "inherit",
    "data": {
      "version": 1,
      "kind": "category-value",
      "mode": "override",
      "rowId": "item",
      "binding": { "variable": "rankingData", "encoding": "key-value-list" },
      "columns": [
        { "id": "item", "label": "Item", "labelZh": "项目", "type": "string", "role": "id", "required": true },
        { "id": "value", "label": "Score", "labelZh": "分数", "type": "number", "role": "value", "required": true }
      ],
      "minRows": 1,
      "maxRows": 8,
      "highlightVariable": "highlight",
      "valueFormat": { "precision": 0, "notation": "standard" }
    },
    "ai": { "slots": ["title", "rankingData", "highlight", "source"], "instructions": "Keep values numeric, provide one to eight ranked rows, and use a highlight that exactly matches an item label." }
  },
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 9,
  "engine": { "name": "gsap", "version": "3.13.0", "seekable": true },
  "files": [{ "path": "ranking-list.html", "target": "compositions/ranking-list.html", "type": "hyperframes:composition" }],
  "variables": [
    { "id": "title", "label": "Title", "type": "string", "default": "Signals ranked by impact", "maxLength": 72, "update": "live" },
    { "id": "rankingData", "label": "Ranking data", "description": "Items and scores, edited as structured rows.", "type": "string", "default": "Clarity:94,Speed:88,Trust:82,Reach:73,Cost:61", "maxLength": 1200, "update": "live" },
    { "id": "highlight", "label": "Highlight", "type": "string", "default": "Clarity", "maxLength": 40, "update": "live" },
    { "id": "source", "label": "Source", "type": "string", "default": "Internal benchmark / Q3", "maxLength": 72, "update": "live" }
  ]
}
