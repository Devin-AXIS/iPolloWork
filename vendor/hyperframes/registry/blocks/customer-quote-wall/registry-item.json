{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "customer-quote-wall",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Customer Quote Wall",
  "description": "Show several concise customer proof points together.",
  "tags": [
    "component",
    "proof",
    "grid",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "proof",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four quote tiles. Keep pipe separators between items and preserve the grid layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "customer-quote-wall.html",
      "target": "compositions/customer-quote-wall.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Customer Quote Wall",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Maya::Review finally feels fast|Noah::The timeline stays clear|Ari::Our brand carries through|Chen::Exports match preview",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Four teams, one repeated signal",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
