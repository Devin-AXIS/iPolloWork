{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "follow-card",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Follow Card",
  "description": "A creator follow prompt with a clear profile hierarchy and one animated action.",
  "tags": [
    "component",
    "social",
    "follow",
    "creator",
    "profile",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "social",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "name",
        "handle",
        "followers",
        "action"
      ],
      "instructions": "Use one recognizable creator name, a short handle, a compact follower count and one direct action label."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 7,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "follow-card.html",
      "target": "compositions/follow-card.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "name",
      "label": "Creator name",
      "type": "string",
      "default": "Noa Studio",
      "maxLength": 40,
      "update": "live"
    },
    {
      "id": "handle",
      "label": "Handle",
      "type": "string",
      "default": "@noastudio",
      "maxLength": 40,
      "update": "live"
    },
    {
      "id": "followers",
      "label": "Follower count",
      "type": "string",
      "default": "128K followers",
      "maxLength": 40,
      "update": "live"
    },
    {
      "id": "action",
      "label": "Action",
      "type": "string",
      "default": "Follow for the next build",
      "maxLength": 48,
      "update": "live"
    }
  ]
}

