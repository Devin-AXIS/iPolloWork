    "usage": {
      "useWhen": [
        "用括号打开一个短概念的范围或章节主题。"
      ],
      "avoidWhen": [
        "不是集合运算或关系图；不能用括号动画证明包含关系、解释公式或模拟界面展开。",
        "不要把文字特效当作全场景内容；避免与运镜或另一强调动作同时争抢焦点。"
      ],
      "inputRules": {
        "title": "一个短概念，单行最多6字；括号用于主题框定，不插入空格模拟逐词字幕。"
      },
      "readingOrder": [
        "建立概念边界",
        "括号展开并露出标题",
        "保持标题与括号稳定可读"
      ],
      "cueBindings": {
        "phase-1": "绑定实测旁白中与“括号张开揭示短标题”对应的精确短语；保持该段原曲线。",
        "phase-2": "绑定实测旁白中与“字距展开后稳定阅读”对应的精确短语；保持该段原曲线。"
      },
      "fallback": {
        "overflow": "拆分语义或选择其他配方，不缩小文字或截断。",
        "missingInput": "要求真实内容，不使用英文演示文案或虚构界面。",
        "timingMismatch": "重新绑定实测短语；内部动作比例不变，超长旁白拆镜。",
        "inapplicable": "选择合适配方；仅配方模式下报告库缺口，不临时绘制替代图形。"
      },
      "example": {
        "values": {
          "title": "理解机制"
        },
        "narration": "理解机制。"
      },
      "acceptance": [
        "括号只承担框定主题的作用，未暗示内容不支持的数学或层级关系。",
        "原始 GSAP / 逐帧函数真实执行，倒放复现同一画面。",
        "每个绑定事件改变实际目标，结束文字完整且可读。",
        "以实际字体和中文内容检查安全边界；不复用演示身份与假素材。"
      ],
      "intent": "用括号框定短概念的讨论范围，让观众知道随后展开的是哪一部分。"
    }
