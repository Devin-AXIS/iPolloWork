{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "shotcraft-blur-slide",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "模糊逐词入场",
  "description": "模糊逐词入场，保留转换版原动作并支持旁白事件绑定。",
  "tags": [
    "component",
    "shotcraft",
    "typography",
    "theme"
  ],
  "author": "Wei Yihao; louiseliu HyperFrames conversion; iPolloWork integration",
  "license": "Apache-2.0",
  "upstream": {
    "repository": "https://github.com/louiseliu/hyperFrames-video-shotcraft",
    "revision": "1df77f1ab080323558f70a5fb880fad0f88f87fc",
    "implementation": "demos/typography/blur-slide/index.html",
    "rules": "references/shots/typography/blur-slide.md",
    "license": "Apache-2.0",
    "upstreamSha256": "2344bb0a587ac9725be3b4a0ef85754a8f2669d04aa979cf5f627e528a41f7ac",
    "adaptation": "Preserves the converted HTML/GSAP source. Modified: editable escaped content, measured phase cues, explicit canvas, final hold and iPolloWork contracts. No generic replacement animation.",
    "referenceGallery": "https://github.com/louiseliu/hyperFrames-video-shotcraft/tree/1df77f1ab080323558f70a5fb880fad0f88f87fc/gallery"
  },
  "source": {
    "provider": "hyperframes-video-shotcraft",
    "label": "HyperFrames Shotcraft · Apache-2.0",
    "url": "https://github.com/louiseliu/hyperFrames-video-shotcraft/blob/1df77f1ab080323558f70a5fb880fad0f88f87fc/references/shots/typography/blur-slide.md"
  },
  "visualComponent": {
    "version": 1,
    "category": "typography",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "subtitle"
      ],
      "instructions": "短标题由模糊到清晰，适合引出一个逐步明确的观点或章节。"
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 5.3,
  "engine": {
    "name": "gsap",
    "version": "3.14.2",
    "seekable": true
  },
  "files": [
    {
      "path": "shotcraft-blur-slide.html",
      "target": "compositions/shotcraft-blur-slide.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "LICENSE",
      "target": "compositions/licenses/hyperframes-video-shotcraft-LICENSE.txt",
      "type": "hyperframes:asset"
    },
    {
      "path": "recipe.md",
      "target": "compositions/shotcraft-blur-slide.recipe.md",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "title",
      "type": "string",
      "default": "先 观察 再 判断",
      "maxLength": 10,
      "update": "reload"
    },
    {
      "id": "subtitle",
      "label": "subtitle",
      "type": "string",
      "default": "理解 机制 才能 选择",
      "maxLength": 20,
      "update": "reload"
    },
    {
      "id": "motionCueTimes",
      "label": "Measured phase cue times",
      "type": "string",
      "default": "{}",
      "maxLength": 2048,
      "update": "reload"
    }
  ],
  "motionRecipe": {
    "version": 1,
    "pattern": "kinetic-type",
    "minHoldSeconds": 0.7,
    "textLimits": {
      "title": {
        "maxLines": 1,
        "maxLineLength": 10
      },
      "subtitle": {
        "maxLines": 1,
        "maxLineLength": 20
      }
    },
    "events": [
      {
        "id": "phase-1",
        "target": ".sc-content *",
        "time": 0.65,
        "duration": 1.292,
        "action": "依次呈现标题词组"
      },
      {
        "id": "phase-2",
        "target": ".sc-content *",
        "time": 1.9420000000000002,
        "duration": 2.508,
        "action": "补充解释并收清模糊"
      }
    ],
    "usage": {
      "useWhen": [
        "短标题由模糊到清晰，适合引出一个逐步明确的观点或章节。"
      ],
      "avoidWhen": [
        "不用于阅读原始证据、数字或关键警示；不要把失焦表现成事实不确定或视频故障。",
        "不要把文字特效当作全场景内容；避免与运镜或另一强调动作同时争抢焦点。"
      ],
      "inputRules": {
        "title": "单行最多10字（含空格），用空格显式划分短词组；不拆散词义。",
        "subtitle": "单行最多20字（含空格），用空格划分词组；只补充标题，不能承载完整旁白。"
      },
      "readingOrder": [
        "先建立短标题词组",
        "标题逐词清晰",
        "补充副标题并保持完整可读"
      ],
      "cueBindings": {
        "phase-1": "绑定实测旁白中与“依次呈现标题词组”对应的精确短语；保持该段原曲线。",
        "phase-2": "绑定实测旁白中与“补充解释并收清模糊”对应的精确短语；保持该段原曲线。"
      },
      "fallback": {
        "overflow": "拆分语义或选择其他配方，不缩小文字或截断。",
        "missingInput": "要求真实内容，不使用英文演示文案或虚构界面。",
        "timingMismatch": "重新绑定实测短语；内部动作比例不变，超长旁白拆镜。",
        "inapplicable": "选择合适配方；仅配方模式下报告库缺口，不临时绘制替代图形。"
      },
      "example": {
        "values": {
          "title": "先 观察 再 判断",
          "subtitle": "理解 机制 才能 选择"
        },
        "narration": "先观察再判断，理解机制才能选择。"
      },
      "acceptance": [
        "标题模糊结束后才要求观众完整阅读；副标题不与主观点竞争。",
        "原始 GSAP / 逐帧函数真实执行，倒放复现同一画面。",
        "每个绑定事件改变实际目标，结束文字完整且可读。",
        "以实际字体和中文内容检查安全边界；不复用演示身份与假素材。"
      ]
    }
  }
}
