{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "next-step-outro",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Next Step Outro",
  "description": "End with one concrete next step and destination.",
  "tags": [
    "component",
    "scene",
    "cta",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "scene",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four call to action. Keep pipe separators between items and preserve the cta layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "next-step-outro.html",
      "target": "compositions/next-step-outro.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Next Step Outro",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "01::Choose a template|02::Add your story|03::Review the result|GO::Create the video",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Make the next move obvious",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
