{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "agenda-opener",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Agenda Opener",
  "description": "Open a structured explainer with a readable agenda.",
  "tags": [
    "component",
    "scene",
    "grid",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "scene",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four agenda cards. Keep pipe separators between items and preserve the grid layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "agenda-opener.html",
      "target": "compositions/agenda-opener.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Agenda Opener",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "01::Context|02::Signal|03::Decision|04::Action",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A clear route through the story",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
