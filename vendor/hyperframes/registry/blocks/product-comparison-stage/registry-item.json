{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "product-comparison-stage",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Product Comparison Stage",
  "description": "Compare two product approaches around customer outcomes.",
  "tags": [
    "component",
    "product",
    "compare",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "product",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four comparison panels. Keep pipe separators between items and preserve the compare layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "product-comparison-stage.html",
      "target": "compositions/product-comparison-stage.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Product Comparison Stage",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Manual::More handoffs|Assisted::One visible flow|Manual::Late review|Assisted::Review in context",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Compare the experience, not only the checklist",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
