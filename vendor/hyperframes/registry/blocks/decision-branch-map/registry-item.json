{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "decision-branch-map",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Decision Branch Map",
  "description": "Map a decision into bounded outcomes and next actions.",
  "tags": [
    "component",
    "diagrams",
    "tree",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "diagrams",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four decision branches. Keep pipe separators between items and preserve the tree layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "decision-branch-map.html",
      "target": "compositions/decision-branch-map.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Decision Branch Map",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Evidence strong::Proceed|Evidence mixed::Test|Risk high::Review|Need unclear::Reframe",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Every branch ends with an action",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
