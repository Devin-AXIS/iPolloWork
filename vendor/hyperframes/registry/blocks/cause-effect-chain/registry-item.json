{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "cause-effect-chain",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Cause & Effect Chain",
  "description": "Teach how one condition creates a sequence of effects.",
  "tags": [
    "component",
    "knowledge",
    "flow",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "knowledge",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four cause chain. Keep pipe separators between items and preserve the flow layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "cause-effect-chain.html",
      "target": "compositions/cause-effect-chain.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Cause & Effect Chain",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Context::Better prompts|Constraint::Fewer guesses|Review::Earlier correction|Outcome::Stronger work",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Show the reason, not only the result",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
