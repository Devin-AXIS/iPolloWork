{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "integration-showcase",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Integration Showcase",
  "description": "Show how integrations connect to the core product workflow.",
  "tags": [
    "component",
    "product",
    "network",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "product",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four integration nodes. Keep pipe separators between items and preserve the network layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "integration-showcase.html",
      "target": "compositions/integration-showcase.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Integration Showcase",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Docs::Bring context|Git::Track change|Chat::Coordinate|Cloud::Deliver",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Connect the tools without losing the workflow",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
