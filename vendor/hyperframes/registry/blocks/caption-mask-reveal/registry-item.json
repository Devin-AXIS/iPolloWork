{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "caption-mask-reveal",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Mask Reveal",
  "description": "A compact subtitle band opens from the baseline and reveals the phrase with a smooth, broadcast-safe mask.",
  "kind": "effect",
  "librarySection": "caption-animation",
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 4,
  "tags": ["caption", "mask", "reveal", "subtitle", "broadcast"],
  "engine": { "name": "gsap", "version": "3.15.0", "seekable": true, "plugins": [] },
  "source": { "provider": "ipollowork", "label": "iPolloWork Motion Library" },
  "motionPreset": {
    "version": 1,
    "category": "caption",
    "targets": ["caption", "text"],
    "anchor": "clip-start",
    "duration": 0.7,
    "ease": "power4.out",
    "keyframes": [
      {
        "percentage": 0,
        "properties": { "opacity": 0, "yPercent": 70, "clipPath": "inset(100% 0 0 0)" }
      },
      {
        "percentage": 78,
        "properties": { "opacity": 1, "yPercent": 0, "clipPath": "inset(0% 0 0 0)" }
      },
      {
        "percentage": 100,
        "properties": { "opacity": 1, "yPercent": 0, "clipPath": "inset(0% 0 0 0)" }
      }
    ]
  },
  "files": [
    {
      "path": "caption-mask-reveal.html",
      "target": "compositions/caption-mask-reveal.html",
      "type": "hyperframes:composition"
    }
  ]
}
