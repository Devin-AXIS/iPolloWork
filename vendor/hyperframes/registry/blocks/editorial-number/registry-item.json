{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "editorial-number",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Editorial Number",
  "description": "Give one number enough hierarchy to carry a scene.",
  "tags": [
    "component",
    "typography",
    "spotlight",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "typography",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four hero number. Keep pipe separators between items and preserve the spotlight layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "editorial-number.html",
      "target": "compositions/editorial-number.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Editorial Number",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "42%::Less review time|3.2×::More approved ideas|18h::Saved per week|94::Quality score",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A number is strongest when its meaning arrives with it",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
