{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "picture-in-picture",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Picture in Picture",
  "description": "Place a supporting view over a primary media surface.",
  "tags": [
    "component",
    "media",
    "frame",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "media",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four primary and inset frames. Keep pipe separators between items and preserve the frame layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "picture-in-picture.html",
      "target": "compositions/picture-in-picture.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Picture in Picture",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Main::Product walkthrough|Inset::Presenter context|Label::Live review|Moment::Approval",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Keep the supporting view secondary",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
