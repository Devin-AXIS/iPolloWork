{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "social-post",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Social Post",
  "description": "A platform-neutral social post card with author identity, message and engagement context.",
  "tags": [
    "component",
    "social",
    "post",
    "creator",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "social",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "author",
        "handle",
        "post",
        "metrics"
      ],
      "instructions": "Keep the post concise, use a real or clearly fictional author identity, and summarize engagement without inventing verified reach."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "social-post.html",
      "target": "compositions/social-post.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "author",
      "label": "Author",
      "type": "string",
      "default": "Ari Chen",
      "maxLength": 40,
      "update": "live"
    },
    {
      "id": "handle",
      "label": "Handle",
      "type": "string",
      "default": "@aricreates",
      "maxLength": 40,
      "update": "live"
    },
    {
      "id": "post",
      "label": "Post",
      "type": "string",
      "default": "A clear story gives every product moment somewhere to land.",
      "maxLength": 180,
      "update": "live"
    },
    {
      "id": "metrics",
      "label": "Engagement",
      "type": "string",
      "default": "2.4K likes · 318 replies · 86 saves",
      "maxLength": 80,
      "update": "live"
    }
  ]
}

