{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "medal-table",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Medal Table",
  "description": "A multi-series ranking table that reveals gold, silver and bronze counts before resolving the total order.",
  "tags": ["component", "data", "ranking", "medals", "multi-series", "theme"],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "data",
    "surfaces": ["video"],
    "themeMode": "inherit",
    "data": {
      "version": 1,
      "kind": "series-value",
      "mode": "replace",
      "rowId": "team",
      "binding": { "variable": "medals", "encoding": "json" },
      "columns": [
        { "id": "team", "label": "Team", "labelZh": "队伍", "type": "string", "role": "id", "required": true },
        { "id": "gold", "label": "Gold", "labelZh": "金牌", "type": "number", "role": "value", "required": true },
        { "id": "silver", "label": "Silver", "labelZh": "银牌", "type": "number", "role": "value", "required": true },
        { "id": "bronze", "label": "Bronze", "labelZh": "铜牌", "type": "number", "role": "value", "required": true }
      ],
      "minRows": 2,
      "maxRows": 6,
      "highlightVariable": "highlight",
      "valueFormat": { "precision": 0, "notation": "standard" }
    },
    "ai": {
      "slots": ["title", "medals", "highlight", "source"],
      "instructions": "Provide two to six teams with non-negative gold, silver and bronze counts. Keep the highlighted team label exact."
    }
  },
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 7,
  "engine": { "name": "gsap", "version": "3.13.0", "seekable": true },
  "files": [{ "path": "medal-table.html", "target": "compositions/medal-table.html", "type": "hyperframes:composition" }],
  "variables": [
    { "id": "title", "label": "Title", "type": "string", "default": "Championship medal table", "maxLength": 72, "update": "live" },
    { "id": "medals", "label": "Medal data", "description": "Gold, silver and bronze counts as structured rows.", "type": "string", "default": "{\"version\":1,\"kind\":\"series-value\",\"rows\":[{\"team\":\"Orion\",\"gold\":12,\"silver\":8,\"bronze\":5},{\"team\":\"Nova\",\"gold\":10,\"silver\":9,\"bronze\":7},{\"team\":\"Atlas\",\"gold\":8,\"silver\":11,\"bronze\":6},{\"team\":\"Pulse\",\"gold\":7,\"silver\":6,\"bronze\":9}]}", "maxLength": 2200, "update": "live" },
    { "id": "highlight", "label": "Highlight", "type": "string", "default": "Orion", "maxLength": 40, "update": "live" },
    { "id": "source", "label": "Source", "type": "string", "default": "Final standings", "maxLength": 72, "update": "live" }
  ]
}
