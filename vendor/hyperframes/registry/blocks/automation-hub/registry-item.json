{
  "name": "automation-hub",
  "type": "hyperframes:block",
  "title": "自动化连接中枢",
  "description": "立体连接中枢、可替换图标、流动光线与脉冲。适合系统架构、智能体协作和自动化讲解。",
  "version": "1.0.0",
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "tags": [
    "component",
    "diagrams",
    "isometric",
    "theme",
    "讲解",
    "宣传"
  ],
  "visualComponent": {
    "version": 1,
    "category": "diagrams",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "data": {
      "version": 1,
      "kind": "category-value",
      "mode": "replace",
      "rowId": "label",
      "binding": {
        "variable": "nodes",
        "encoding": "json"
      },
      "columns": [
        {
          "id": "label",
          "label": "Name",
          "labelZh": "名称",
          "type": "string",
          "role": "label",
          "required": true
        },
        {
          "id": "icon",
          "label": "Icon",
          "labelZh": "图标",
          "type": "string",
          "role": "value",
          "options": [
            {
              "value": "workflow",
              "label": "工作流"
            },
            {
              "value": "settings",
              "label": "设置"
            },
            {
              "value": "zap",
              "label": "闪电"
            },
            {
              "value": "layers",
              "label": "图层"
            },
            {
              "value": "brain",
              "label": "智能"
            },
            {
              "value": "database",
              "label": "数据库"
            },
            {
              "value": "bot",
              "label": "机器人"
            },
            {
              "value": "globe",
              "label": "全球"
            },
            {
              "value": "cpu",
              "label": "算力"
            },
            {
              "value": "chart",
              "label": "分析"
            },
            {
              "value": "mail",
              "label": "消息"
            },
            {
              "value": "code",
              "label": "代码"
            }
          ]
        },
        {
          "id": "image",
          "label": "Custom icon",
          "labelZh": "自定义图标",
          "type": "string",
          "role": "value",
          "format": "image"
        }
      ],
      "minRows": 2,
      "maxRows": 12
    },
    "ai": {
      "slots": [
        "centerLabel",
        "nodes",
        "speed",
        "tilt",
        "radius",
        "nodeScale",
        "glow",
        "labels",
        "grid"
      ],
      "instructions": "Edit native variables and structured node rows; do not rewrite the drawing. Icon is a provided enum or embedded image. Node count is the number of rows. Theme colors and typography inherit from the project. Playback is deterministic and owned by the host timeline."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 16,
  "engine": {
    "name": "gsap",
    "version": "3.14.2",
    "seekable": true
  },
  "files": [
    {
      "path": "automation-hub.html",
      "target": "compositions/automation-hub/automation-hub.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "gsap.min.js",
      "target": "compositions/automation-hub/gsap.min.js",
      "type": "hyperframes:asset"
    },
    {
      "path": "NOTICE",
      "target": "compositions/automation-hub/NOTICE",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "centerLabel",
      "label": "中心标题",
      "type": "string",
      "default": "AUTOMATIONS\nUNLEASHED",
      "maxLength": 60,
      "update": "reload"
    },
    {
      "id": "nodes",
      "label": "节点 / 内容",
      "type": "string",
      "default": "{\"version\":1,\"kind\":\"category-value\",\"rows\":[{\"id\":\"node-1\",\"label\":\"自动化\",\"icon\":\"settings\"},{\"id\":\"node-2\",\"label\":\"智能体\",\"icon\":\"brain\"},{\"id\":\"node-3\",\"label\":\"即时执行\",\"icon\":\"zap\"},{\"id\":\"node-4\",\"label\":\"知识库\",\"icon\":\"layers\"},{\"id\":\"node-5\",\"label\":\"工作流\",\"icon\":\"workflow\"},{\"id\":\"node-6\",\"label\":\"应用集成\",\"icon\":\"code\"}]}",
      "update": "reload"
    },
    {
      "id": "speed",
      "label": "动画速度",
      "type": "number",
      "default": 1,
      "min": 0.3,
      "max": 2.5,
      "step": 0.1,
      "update": "reload"
    },
    {
      "id": "tilt",
      "label": "透视倾角",
      "type": "number",
      "default": 0.68,
      "min": 0.44,
      "max": 0.86,
      "step": 0.01,
      "update": "reload"
    },
    {
      "id": "radius",
      "label": "排列半径",
      "type": "number",
      "default": 322,
      "min": 270,
      "max": 360,
      "step": 1,
      "update": "reload"
    },
    {
      "id": "nodeScale",
      "label": "图标尺寸",
      "type": "number",
      "default": 1,
      "min": 0.72,
      "max": 1.15,
      "step": 0.01,
      "update": "reload"
    },
    {
      "id": "glow",
      "label": "辉光强度",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1.5,
      "step": 0.1,
      "update": "reload"
    },
    {
      "id": "labels",
      "label": "显示节点名称",
      "type": "boolean",
      "default": true,
      "update": "reload"
    },
    {
      "id": "grid",
      "label": "背景网格",
      "type": "boolean",
      "default": true,
      "update": "reload"
    }
  ],
  "source": {
    "provider": "ipollowork-local-import",
    "label": "iPolloWork reusable components"
  }
}
