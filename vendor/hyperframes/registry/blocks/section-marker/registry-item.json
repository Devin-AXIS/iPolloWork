{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "section-marker",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Section Marker",
  "description": "Mark a new section with a compact editorial lockup.",
  "tags": [
    "component",
    "typography",
    "editorial",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "typography",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four section label. Keep pipe separators between items and preserve the editorial layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "section-marker.html",
      "target": "compositions/section-marker.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Section Marker",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "01::THE CONTEXT|02::THE SIGNAL|03::THE SHIFT|04::THE RESULT",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A restrained marker for fast-moving explainers",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
