{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "team-spotlight",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Team Spotlight",
  "description": "Feature one team member and their current contribution.",
  "tags": [
    "component",
    "people",
    "profile",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "people",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four team member profile. Keep pipe separators between items and preserve the profile layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "team-spotlight.html",
      "target": "compositions/team-spotlight.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Team Spotlight",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Jordan Lee::Motion systems|Now::Component library|Strength::Turning rules into tools|Next::Scaling review",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "One person, one contribution, one next step",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
