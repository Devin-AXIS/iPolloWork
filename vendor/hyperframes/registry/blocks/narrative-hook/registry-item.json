{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "narrative-hook",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Narrative Hook",
  "description": "Open with a tension-and-payoff story hook.",
  "tags": [
    "component",
    "scene",
    "editorial",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "scene",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four hook statement. Keep pipe separators between items and preserve the editorial layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "narrative-hook.html",
      "target": "compositions/narrative-hook.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Narrative Hook",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Problem::Too much motion|Tension::Not enough meaning|Shift::Make every beat useful|Promise::A clearer story",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "The first five seconds earn the next five",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
