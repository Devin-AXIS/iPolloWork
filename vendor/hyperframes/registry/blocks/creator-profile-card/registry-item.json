{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "creator-profile-card",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Creator Profile Card",
  "description": "Introduce a creator with platform identity and content pillars.",
  "tags": [
    "component",
    "social",
    "social",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "social",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four creator card. Keep pipe separators between items and preserve the social layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "creator-profile-card.html",
      "target": "compositions/creator-profile-card.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Creator Profile Card",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "@mayamakes::Design systems|128K::Followers|2.4M::Monthly views|Weekly::New explainers",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A reusable creator identity card",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
