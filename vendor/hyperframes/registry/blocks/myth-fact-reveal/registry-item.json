{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "myth-fact-reveal",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Myth / Fact Reveal",
  "description": "Correct a misconception with a concise explanation.",
  "tags": [
    "component",
    "knowledge",
    "compare",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "knowledge",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four myth and fact. Keep pipe separators between items and preserve the compare layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "myth-fact-reveal.html",
      "target": "compositions/myth-fact-reveal.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Myth / Fact Reveal",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "Myth::More effects mean better video|Fact::Clear hierarchy wins|Why::Attention is limited|Use::One motion idea per beat",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Replace the assumption with a useful rule",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
