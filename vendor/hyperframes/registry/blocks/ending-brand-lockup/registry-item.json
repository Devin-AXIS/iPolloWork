{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "ending-brand-lockup",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Brand Lockup",
  "description": "A calm final message resolves into a polished logo and call-to-action lockup with a generous hold.",
  "kind": "animation",
  "librarySection": "ending-animation",
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 4.5,
  "tags": ["ending", "brand", "cta", "minimal", "resolve"],
  "engine": { "name": "gsap", "version": "3.15.0", "seekable": true, "plugins": [] },
  "source": { "provider": "ipollowork", "label": "iPolloWork Motion Library" },
  "motionPreset": {
    "version": 1,
    "category": "ending",
    "targets": ["any", "text", "image", "shape", "group"],
    "anchor": "clip-end",
    "duration": 1.25,
    "ease": "power3.out",
    "keyframes": [
      {
        "percentage": 0,
        "properties": { "opacity": 0, "y": 32, "scale": 0.96, "filter": "blur(10px)" }
      },
      {
        "percentage": 70,
        "properties": { "opacity": 1, "y": 0, "scale": 1.015, "filter": "blur(0px)" }
      },
      {
        "percentage": 100,
        "properties": { "opacity": 1, "y": 0, "scale": 1, "filter": "blur(0px)" }
      }
    ]
  },
  "files": [
    {
      "path": "ending-brand-lockup.html",
      "target": "compositions/ending-brand-lockup.html",
      "type": "hyperframes:composition"
    }
  ]
}
