{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "social-comment-highlight",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Social Comment Highlight",
  "description": "Elevate one useful audience comment from a conversation.",
  "tags": [
    "component",
    "social",
    "stack",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "social",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four comment stack. Keep pipe separators between items and preserve the stack layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "social-comment-highlight.html",
      "target": "compositions/social-comment-highlight.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Social Comment Highlight",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "@lin::This saved our review|@omar::The workflow finally clicks|@sora::Can we reuse this?|@team::Yes — as a template",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "Turn audience feedback into a story beat",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
