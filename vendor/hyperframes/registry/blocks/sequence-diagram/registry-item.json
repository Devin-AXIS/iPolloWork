{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "sequence-diagram",
  "version": "1.0.0",
  "type": "hyperframes:block",
  "title": "Sequence Diagram",
  "description": "Explain messages exchanged between systems over time.",
  "tags": [
    "component",
    "diagrams",
    "lanes",
    "theme"
  ],
  "author": "iPolloWork",
  "license": "Apache-2.0",
  "visualComponent": {
    "version": 1,
    "category": "diagrams",
    "surfaces": [
      "video"
    ],
    "themeMode": "inherit",
    "ai": {
      "slots": [
        "title",
        "items",
        "highlight",
        "note"
      ],
      "instructions": "AI may rewrite the title, supporting note, and up to four system messages. Keep pipe separators between items and preserve the lanes layout."
    }
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "engine": {
    "name": "gsap",
    "version": "3.13.0",
    "seekable": true
  },
  "files": [
    {
      "path": "sequence-diagram.html",
      "target": "compositions/sequence-diagram.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "default": "Sequence Diagram",
      "maxLength": 76,
      "update": "live"
    },
    {
      "id": "items",
      "label": "Items (label::detail | ...)",
      "type": "string",
      "default": "User→App::Request|App→Agent::Delegate|Agent→Tool::Execute|Tool→App::Return",
      "maxLength": 280,
      "update": "live"
    },
    {
      "id": "highlight",
      "label": "Highlighted item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "update": "live"
    },
    {
      "id": "note",
      "label": "Supporting note",
      "type": "string",
      "default": "A readable message path across system boundaries",
      "maxLength": 100,
      "update": "live"
    }
  ]
}
