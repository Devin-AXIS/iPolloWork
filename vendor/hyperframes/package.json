{
  "name": "hyperframes-monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/heygen-com/hyperframes"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run studio",
    "build": "bun run build:local-studio",
    "build:local-studio": "bun run --filter '@hyperframes/{parsers,lint,studio-server}' build && bun run --filter @hyperframes/core build && bun run --filter @hyperframes/producer build:fonts && bun run --filter '@hyperframes/{core,engine,producer,player,studio,shader-transitions,sdk}' build && bun run --filter @hyperframes/cli build",
    "build:producer": "bun run --filter @hyperframes/producer build",
    "studio": "bun run --filter @hyperframes/studio dev",
    "build:hyperframes-runtime": "bun run --filter @hyperframes/core build:hyperframes-runtime",
    "build:hyperframes-runtime:modular": "bun run --filter @hyperframes/core build:hyperframes-runtime:modular",
    "sync-schemas": "tsx scripts/sync-schemas.ts",
    "sync-schemas:check": "tsx scripts/sync-schemas.ts --check",
    "gsap:generate": "bun scripts/gsap-catalog.ts generate",
    "gsap:check": "bun scripts/gsap-catalog.ts check",
    "gsap:check-updates": "bun scripts/gsap-catalog.ts upstream",
    "gsap:sync": "bun scripts/gsap-catalog.ts sync",
    "lint": "oxlint packages/cli packages/core packages/engine packages/lint packages/parsers packages/player packages/producer packages/sdk packages/shader-transitions packages/studio packages/studio-server",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check packages/cli packages/core packages/engine packages/lint packages/parsers packages/player packages/producer packages/sdk packages/shader-transitions packages/studio packages/studio-server",
    "test": "echo skip",
    "prepare": "test -d .git && lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@hyperframes/player": "workspace:*",
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "fallow": "^3.16.0",
    "happy-dom": "^20.9.0",
    "knip": "^6.32.3",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.56.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "resolutions": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "overrides": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
