HOST=127.0.0.1
PORT=4785
SERVICE_ORIGIN=http://localhost:4785
DATA_DIR=./data
DATABASE_URL=postgresql://ipollowork:replace-password@127.0.0.1:5432/ipollowork
DATABASE_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_QUEUE_LIMIT=128
API_CONCURRENCY=32
AUTH_CONCURRENCY=2
EXECUTION_CONCURRENCY=8
TRANSFER_CONCURRENCY=4
MCP_CONCURRENCY=128
REQUEST_QUEUE_LIMIT=160
API_QUEUE_WAIT_MS=5000
AUTH_QUEUE_WAIT_MS=20000
WORK_QUEUE_WAIT_MS=120000
SHUTDOWN_GRACE_MS=25000
RELAY_MAX_CONNECTIONS=200
RELAY_MAX_PENDING=32
RELAY_REFRESH_INTERVAL_MS=5000
DATABASE_SCHEMA=public
AUTH_SECRET=
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
TRUSTED_PROXY_IPS=
# Empty means required for public origins and optional on loopback.
REQUIRE_OSS=
# Set only on an ECS instance with this least-privilege role attached.
OSS_RAM_ROLE=
OSS_INTERNAL=false
PUBLICATION_ORIGIN=
MAX_PUBLICATION_FILES=100
PERSONAL_STORAGE_GIB=200
ORGANIZATION_STORAGE_GIB=500
PERSONAL_RETENTION_DAYS=7
MAX_ARTIFACT_BYTES=536870912
UPLOAD_RESERVATION_MS=3600000
STORAGE_CLEANUP_INTERVAL_MS=60000
PAYMENT_FEE_BPS=500
# Daily/weekly caps are paused; balances and metering remain active.
USAGE_LIMITS_ENABLED=false
USAGE_UTC_OFFSET_MINUTES=480
MINIMUM_MARGIN_BPS=3000
MEMBERSHIP_OPERATING_RESERVE_FEN=3000
# App data uses its own PostgreSQL database; leave empty to disable the feature.
APP_DATA_DATABASE_URL=
APP_DATA_POOL_SIZE=10
APP_DATA_STATEMENT_TIMEOUT_MS=5000
APP_DATA_MAX_RECORD_BYTES=16384
APP_DATA_MAX_RECORDS_PER_APP=100000
APP_DATA_MAX_BYTES_PER_APP=67108864
APP_DATA_MAX_APPS_PER_OWNER=1000
APP_DATA_MAX_BYTES_PER_OWNER=1073741824
APP_DATA_OWNER_CONCURRENCY=8
APP_DATA_ANONYMOUS_PER_MINUTE=120
APP_DATA_ANONYMOUS_CREATES_PER_MINUTE=20
APP_DATA_ANONYMOUS_CONCURRENCY=4
APP_DATA_TOMBSTONE_DAYS=30
# Only used by compose.yml. URL-encode this value in DATABASE_URL outside Compose.
POSTGRES_PASSWORD=
