HOST=127.0.0.1
PORT=4785
SERVICE_ORIGIN=http://localhost:4785
DATA_DIR=./data
DATABASE_URL=postgresql://ipollowork:replace-password@127.0.0.1:5432/ipollowork
DATABASE_POOL_SIZE=20
DATABASE_SCHEMA=public
AUTH_SECRET=
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
TRUSTED_PROXY_IPS=
# Empty means required for public origins and optional on loopback.
REQUIRE_OSS=
# Set only on an ECS instance with this least-privilege role attached.
OSS_RAM_ROLE=
OSS_INTERNAL=false
PUBLICATION_ORIGIN=
MAX_PUBLICATION_FILES=100
PERSONAL_STORAGE_GIB=200
ORGANIZATION_STORAGE_GIB=500
PERSONAL_RETENTION_DAYS=7
MAX_ARTIFACT_BYTES=536870912
UPLOAD_RESERVATION_MS=3600000
STORAGE_CLEANUP_INTERVAL_MS=60000
PAYMENT_FEE_BPS=500
MINIMUM_MARGIN_BPS=3000
MEMBERSHIP_OPERATING_RESERVE_FEN=3000
# Only used by compose.yml. URL-encode this value in DATABASE_URL outside Compose.
POSTGRES_PASSWORD=
