      { "id": "logoUrl", "label": "品牌标志", "type": "image", "group": "brand" }
    ]
  },
  "applyChecklist": [
    "保持根合成、视口和画布为 1080×1920（9:16），除非用户明确要求更换视频格式。",
    "替换主标题、核心数据、两条证明要点和行动号召，并确保每个镜头在手机屏幕上可读。",
    "通过 design-tokens.css 调整颜色、字体、圆角和间距，不要破坏竖屏安全区。",
    "导出前确认 Video Studio 显示的源尺寸为 1080×1920，1080p 导出使用 portrait 预设。"
  ],
  "minimumAppVersion": "0.17.28"
