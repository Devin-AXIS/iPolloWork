    "variables": [
      { "id": "eyebrow", "label": "顶部标签", "type": "text", "group": "content" },
      { "id": "title", "label": "主标题", "type": "text", "group": "content" },
      { "id": "subtitle", "label": "副标题", "type": "text", "group": "content" },
      { "id": "metric", "label": "核心数据", "type": "text", "group": "content" },
      { "id": "metricLabel", "label": "数据说明", "type": "text", "group": "content" },
      { "id": "proofA", "label": "证明要点一", "type": "text", "group": "content" },
      { "id": "proofB", "label": "证明要点二", "type": "text", "group": "content" },
      { "id": "cta", "label": "行动号召", "type": "text", "group": "content" },
