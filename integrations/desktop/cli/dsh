#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
case "$(uname -s)" in
  Linux) executable="$resources/../ipollo"; dsh="$resources/dsh" ;;
  *) executable="$resources/../MacOS/iPollo"; dsh="$resources/app.asar/dsh" ;;
esac
ELECTRON_RUN_AS_NODE=1 exec "$executable" --expose-internals "$dsh/node_modules/@ipollo/desktop-host/lib/cli.js" "$@"
