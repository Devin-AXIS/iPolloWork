{
  "name": "@ipollo/desktop",
  "description": "Electron desktop shell for a bundled dsh runtime and external plugins",
  "version": "1.0.17",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "iPolloWork contributors"
  },
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "test:installer": "node scripts/test-windows-installer.mjs",
    "build": "tsc -b && npm run bundle",
    "bundle": "tsdown --config-loader native",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts --skip-build",
    "test:updates:channels": "npm run build && node scripts/test-update-channels.mjs",
    "test:updates:local": "npm run build && node scripts/test-local-updater.mjs",
    "prepare:runtime": "tsx scripts/prepare-runtime.ts",
    "render:tray-icon": "tsx scripts/render-tray-icon.ts",
    "prepare:primary-runtime": "tsx scripts/prepare-primary-runtime.ts",
    "sign:primary-runtime": "tsx scripts/sign-primary-runtime.ts",
    "cache:windows-signatures": "node scripts/manage-windows-signature-cache.mjs",
    "prepare:packages": "tsx scripts/prepare-package-set.ts",
    "prepare:dsh": "tsx scripts/prepare-dsh.ts",
    "prepare:package": "tsx scripts/package-target.ts --prepare-only",
    "verify:mac-signature": "node scripts/verify-macos-signature.mjs",
    "package": "tsx scripts/package-target.ts",
    "check:package": "tsx scripts/package-target.ts --check",
    "restore:mac-proxy": "tsx scripts/macos-notarization-proxy.ts",
    "package:dir": "tsx scripts/package-target.ts --dir",
    "package:mac:arm64": "tsx scripts/package-target.ts mac-arm64",
    "package:mac:arm64:unsigned": "tsx scripts/package-target.ts mac-arm64 --unsigned",
    "package:mac:arm64:dir": "tsx scripts/package-target.ts mac-arm64 --dir",
    "package:mac:x64": "tsx scripts/package-target.ts mac-x64",
    "package:mac:x64:unsigned": "tsx scripts/package-target.ts mac-x64 --unsigned",
    "package:mac:x64:dir": "tsx scripts/package-target.ts mac-x64 --dir",
    "package:win:x64": "tsx scripts/package-target.ts win-x64",
    "package:win:x64:unsigned": "tsx scripts/package-target.ts win-x64 --unsigned",
    "package:win:x64:dir": "tsx scripts/package-target.ts win-x64 --dir",
    "upload:mac:arm64": "tsx scripts/upload-target.ts mac-arm64",
    "upload:mac:x64": "tsx scripts/upload-target.ts mac-x64",
    "upload:win:x64": "tsx scripts/upload-target.ts win-x64",
    "upload:latest:mac:arm64": "tsx scripts/upload-target.ts mac-arm64 --latest",
    "upload:latest:mac:x64": "tsx scripts/upload-target.ts mac-x64 --latest",
    "upload:latest:win:x64": "tsx scripts/upload-target.ts win-x64 --latest",
    "purge:latest": "tsx scripts/upload-target.ts --latest --purge-only"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "ws": "^8.21.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-error": "0.2.3-alpha.2",
    "@deepseek-ai/cordis": "4.2.0-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-brand": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-host-authentication-desktop": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-browser": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-official-bundles": "0.2.3-alpha.2",
    "@deepseek-ai/node-addon-system": "0.1.2",
    "@electron/get": "^5.1.0",
    "@electron/notarize": "2.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "app-builder-lib": "26.17.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.3.2",
    "yaml": "2.9.0",
    "koffi": "3.1.1",
    "pnpm": "11.28.5",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-deepseek-account": "0.2.3-alpha.2",
    "@types/ws": "^8.18.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.3-alpha.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^6.4.3",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-product-analytics": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.3-alpha.2",
    "zod": "4.6.6",
    "@deepseek-ai/dsh-util-file-drag": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-file-actions": "0.2.3-alpha.2",
    "tencentcloud-sdk-nodejs-teo": "4.1.330",
    "@deepseek-ai/dsh-desktop-publisher": "0.2.3-alpha.2"
  }
}
