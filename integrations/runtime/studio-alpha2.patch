@@ -0,0 +1,157 @@
+/** Discover host media tools and prepare the pinned fallback for installed Video Studio. */
+import { createHash, randomUUID } from "node:crypto";
+import { constants, createReadStream, createWriteStream } from "node:fs";
+import { access, mkdir, rename, rm, stat } from "node:fs/promises";
+import { homedir } from "node:os";
+import { delimiter, isAbsolute, join, resolve } from "node:path";
+import { Transform } from "node:stream";
+import { pipeline } from "node:stream/promises";
+import { createGunzip } from "node:zlib";
+import type { ServiceConfig } from "../../studio-core/src/config-types.ts";
+
+const release = "b6.1.1";
+const source = `https://github.com/eugeneware/ffmpeg-static/releases/download/${release}/`;
+const tools = [
+  { name: "ffmpeg", setting: "ffmpegPath", env: "HYPERFRAMES_FFMPEG_PATH" },
+  { name: "ffprobe", setting: "ffprobePath", env: "HYPERFRAMES_FFPROBE_PATH" },
+] as const;
+
+type ToolName = (typeof tools)[number]["name"];
+type Asset = { bytes: number; sha256: string };
+type Paths = Pick<ServiceConfig, "ffmpegPath" | "ffprobePath">;
+
+const assets: Record<string, Record<ToolName, Asset>> = {
+  "darwin-arm64": {
+    ffmpeg: { bytes: 45568216, sha256: "a90e3db6a3fd35f6074b013f948b1aa45b31c6375489d39e572bea3f18336584" },
+    ffprobe: { bytes: 45528808, sha256: "bb2db6f5d8cef919da12fbf592119a987202a8c060a886f3cab091f9cab90b64" },
+  },
+  "darwin-x64": {
+    ffmpeg: { bytes: 78862176, sha256: "ebdddc936f61e14049a2d4b549a412b8a40deeff6540e58a9f2a2da9e6b18894" },
+    ffprobe: { bytes: 78780408, sha256: "fa3add0ce901f7241abe0dfc0155d958fc834aca3f8ce61f87cc712ae669c1e0" },
+  },
+  "linux-x64": {
+    ffmpeg: { bytes: 79826272, sha256: "e7e7fb30477f717e6f55f9180a70386c62677ef8a4d4d1a5d948f4098aa3eb99" },
+    ffprobe: { bytes: 79665792, sha256: "4f231a1960d83e403d08f7971e271707bec278a9ae18e21b8b5b03186668450d" },
+  },
+  "win32-x64": {
+    ffmpeg: { bytes: 82797568, sha256: "04e1307997530f9cf2fe35cba2ca7e8875ca91da02f89d6c7243df819c94ad00" },
+    ffprobe: { bytes: 82668032, sha256: "3a7e2dc003dc2cd1472827e4c7c4f056ae1ae0ae7c5bbc580c99b49827351ba4" },
+  },
+};
+
+async function isExecutable(path: string) {
+  try {
+    if (!(await stat(path)).isFile()) return false;
+    await access(path, constants.X_OK);
+    return true;
+  } catch (error) {
+    if (["ENOENT", "ENOTDIR", "EACCES", "EPERM"].includes((error as NodeJS.ErrnoException).code ?? ""))
+      return false;
+    throw error;
+  }
+}
+
+async function matchesAsset(path: string, asset: Asset, signal: AbortSignal) {
+  if (!(await isExecutable(path)) || (await stat(path)).size !== asset.bytes) return false;
+  const hash = createHash("sha256");
+  for await (const chunk of createReadStream(path, { signal })) hash.update(chunk);
+  return hash.digest("hex") === asset.sha256;
+}
+
+async function downloadAsset(
+  target: string, path: string, tool: ToolName, asset: Asset, signal: AbortSignal,
+) {
+  const requestSignal = AbortSignal.any([signal, AbortSignal.timeout(45_000)]);
+  const response = await fetch(source + `${tool}-${target}.gz`, { signal: requestSignal });
+  if (!response.ok || !response.body) throw Error(`${tool} download returned HTTP ${response.status}`);
+
+  const temporary = path + "." + randomUUID() + ".tmp";
+  const hash = createHash("sha256");
+  let bytes = 0;
+  const verify = new Transform({
+    transform(chunk: Buffer, _encoding, callback) {
+      bytes += chunk.length;
+      if (bytes > asset.bytes) {
+        callback(Error(`${tool} download exceeded its verified size`));
+        return;
+      }
+      hash.update(chunk);
+      callback(null, chunk);
+    },
+  });
+  try {
+    await pipeline(response.body, createGunzip(), verify,
+      createWriteStream(temporary, { mode: 0o700, flags: "wx" }), { signal: requestSignal });
+    if (bytes !== asset.bytes || hash.digest("hex") !== asset.sha256)
+      throw Error(`${tool} download failed integrity verification`);
+    requestSignal.throwIfAborted();
+    try {
+      await rename(temporary, path);
+    } catch (error) {
+      // Another profile may have installed the same executable in this cache.
+      if (!(await matchesAsset(path, asset, requestSignal))) throw error;
+    }
+  } finally {
+    await rm(temporary, { force: true });
+  }
+}
+
+/** One instance shares downloading and verifies cached executables before use. */
+export class VideoMediaTools {
+  private readonly preparing = new Map<string, Promise<string>>();
+
+  async environment(
+    settings: Partial<Paths>, searchPath: string, signal: AbortSignal, report: (error: unknown) => void,
+  ): Promise<NodeJS.ProcessEnv> {
+    const target = `${process.platform}-${process.arch}`;
+    const directories = searchPath.split(delimiter).map((path) => path.replace(/^"(.*)"$/, "$1")).filter(isAbsolute);
+    const home = process.env.DSH_HOME?.trim() || join(homedir(), ".dsh");
+    const cache = resolve(home, "cache", "ipollowork-video", "ffmpeg", release, target);
+    const result: NodeJS.ProcessEnv = {};
+    await Promise.all(tools.map(async ({ name, setting, env }) => {
+      const filename = name + (process.platform === "win32" ? ".exe" : "");
+      try {
+        for (const configured of [settings[setting]?.trim(), process.env[env]?.trim()]) {
+          if (!configured) continue;
+          const path = resolve(configured);
+          if (await isExecutable(path)) {
+            result[env] = path;
+            return;
+          }
+          report(Error("Configured " + name + " path is unavailable."));
+        }
+        for (const directory of directories) {
+          const installed = join(directory, filename);
+          if (await isExecutable(installed)) {
+            result[env] = installed;
+            return;
+          }
+        }
+        const asset = assets[target]?.[name];
+        if (!asset) return;
+        const path = join(cache, filename);
+        let pending = this.preparing.get(path);
+        if (!pending) {
+          pending = this.prepare(cache, target, path, name, asset, signal)
+            .finally(() => this.preparing.delete(path));
+          this.preparing.set(path, pending);
+        }
+        result[env] = await pending;
+      } catch (error) {
+        signal.throwIfAborted();
+        // Keep preview available. The next cold preview retries missing tools.
+        report(error);
+      }
+    }));
+    return result;
+  }
+
+  private async prepare(
+    cache: string, target: string, path: string, name: ToolName, asset: Asset, signal: AbortSignal,
+  ) {
+    if (await matchesAsset(path, asset, signal)) return path;
+    await mkdir(cache, { recursive: true, mode: 0o700 });
+    await downloadAsset(target, path, name, asset, signal);
+    return path;
+  }
+}
