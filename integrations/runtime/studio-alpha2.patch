+import type { Context } from "@deepseek-ai/cordis";
+import { BUNDLED_SKILL_RANK } from "@deepseek-ai/dsh-skill";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+
+/** Each Studio owns a provider so stopping either one leaves the other's Skill available. */
+export function registerReferenceSkill(ctx: Context, kind: "design" | "video", packageRoot: string): void {
+  const name = "ipollowork-reference-analyzer";
+  const provider = `ipollowork-${kind}-reference`;
+  const directory = resolve(packageRoot, "skills", name);
+  const path = resolve(directory, "SKILL.md");
+  const content = readFileSync(path, "utf8").replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n/, "");
+  const summary = {
+    name, provider, path,
+    description: "Read creative-context.json and verify how source facts, design evidence and local assets inform a Studio project.",
+    invocation: { modelInvocable: true, userInvocable: true },
+    source: "bundled" as const,
+    resourceBase: { kind: "directory" as const, path: directory },
+  };
+  ctx.skills.registerProvider(() => ({
+    name: provider,
+    async list() { return [{ ...summary, rank: BUNDLED_SKILL_RANK, locator: path }]; },
+    async get(candidate) { return candidate.locator === path ? { ...summary, content } : undefined; },
+  }));
+}
