+  page.setDefaultTimeout(25000);
+  const output = resolve(".runtime/browser-verification", profile, "design-generated-presentation");
+  await mkdir(output, { recursive: true });
+  const origin = new URL(address).origin;
+  const fixture = origin + "/studio-ai-fixture";
+  const setup = await fetch(fixture + "/select", {
+    method: "POST",
+    headers: { cookie, "content-type": "application/json" },
+    body: JSON.stringify({ createDesign: true, designPath: path, html }),
+  });
+  assert.equal(setup.status, 200);
+  try {
+    await page.goto(address);
+    await dismissStartup(page);
+    await page.getByRole("button", { name: /^(New session|新会话|新建会话)$/ }).last().click();
+    const chooser = page.getByRole("button", { name: /^(Choose workspace|选择工作区)$/ });
+    if (await chooser.isVisible()) {
+      await chooser.click();
+      await page.getByRole("menuitem", { name: /^(Default workspace|默认工作区)/ }).click();
+    }
+    if (!(await page.getByRole("button", { name: /Studio AI fixture/ }).isVisible())) {
+      await page.getByRole("button", { name: /^(Choose model|Select model|Please select a model|请选择模型)$/ }).click();
+      await page.getByRole("menuitemradio", { name: "Studio AI fixture" }).click();
+    }
+    await page.locator('[contenteditable="true"][role="textbox"]').fill(prompt);
+    await page.getByRole("button", { name: /^(Send message|发送消息)$/ }).click();
+    await page.getByText("DESIGN_FIXTURE_COMPLETE", { exact: false }).waitFor();
+    const captured = await fetch(fixture, { headers: { cookie } }).then((response) => response.json());
+    const firstRequest = JSON.stringify(captured.requests[0]);
+    assert.ok(firstRequest.includes(prompt));
+    assert.ok(firstRequest.includes("put CSS in the HTML"));
+    assert.ok(!firstRequest.includes("Active Design document:"), "the generation starts with an unbound conversation");
+    const registry = JSON.parse(await readFile(resolve(home, "storages/workspace.json"), "utf8")).tables.workspaces;
+    const workspace = Object.values(registry).find((item) => existsSync(resolve(item.path, path)));
+    assert.ok(workspace, "the model wrote the delivered file to its workspace");
+    const file = resolve(workspace.path, path);
+    assert.equal(await readFile(file, "utf8"), html);
+    assert.equal(existsSync(resolve(workspace.path, "design", tokenFile)), false);
+
+    const card = page.locator("[data-presented-file]").filter({ hasText: filename }).last();
+    const preview = page.locator("[data-studio-editor]:visible");
+    const collapse = page.getByRole("button", { name: /^(Collapse right sidebar|收起右侧边栏)$/ });
+    const cover = (name) => page.frameLocator("[data-studio-editor] iframe:visible").getByText(name, { exact: true }).first();
+    await card.waitFor();
+    for (const action of [
+      card.getByRole("button", { name: /simple-presentation\.html/ }),
+      card.getByRole("button", { name: /^(Edit in Design|在 Design 中编辑)$/ }),
+    ]) {
+      if (await preview.isVisible()) await collapse.click();
+      await preview.waitFor({ state: "hidden" });
+      const history = page.waitForResponse(response => {
+        const url = new URL(response.url());
+        return response.ok() && url.pathname === "/ipollowork-design/api/history" && url.searchParams.get("path") === path;
+      });
+      await action.click();
+      await history;
+      await cover(title).waitFor();
+      assert.equal(await page.getByText("Design Studio file was not found.", { exact: true }).count(), 0);
+    }
+    await page.screenshot({ path: resolve(output, "opened.png") });
+    const edit = page.getByTestId("design-edit-toggle").filter({ visible: true });
+    if (await edit.getAttribute("aria-pressed") !== "true") await edit.click();
+    await cover(title).dblclick();
+    await cover(title).fill(editedTitle);
+    await page.keyboard.press("Tab");
+    const saved = page.waitForResponse(response =>
+      response.url().endsWith("/ipollowork-design/api/file") && response.request().method() === "POST");
+    await page.getByRole("button", { name: /^(Save design|保存设计)$/ }).click();
+    const saveItem = page.getByRole("menuitem", { name: /^(Save design|保存设计)$/ });
+    if (await saveItem.isVisible()) await saveItem.click();
+    assert.equal((await saved).status(), 200);
+    const persisted = await readFile(file, "utf8");
+    assert.ok(persisted.includes(editedTitle));
+    assert.equal(persisted.match(/<section\b[^>]*\bdata-ipw-slide(?=[\s=>])/g)?.length, 4);
+    assert.ok(persisted.includes(`href="${tokenFile}"`), "save preserves the authored link");
+    assert.equal(existsSync(resolve(workspace.path, "design", tokenFile)), false);
+    await cover(editedTitle).waitFor();
+    await page.screenshot({ path: resolve(output, "saved.png") });
+    console.log("New conversation: delivered four slides, opened both card actions with missing CSS, loaded history and saved the edit.");
+  } catch (error) {
+    await page.screenshot({ path: resolve(output, "failure.png") }).catch(() => {});
+    throw error;
+  } finally {
+    await browser.close();
+  }
+}
