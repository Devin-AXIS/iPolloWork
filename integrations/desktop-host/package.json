    "@deepseek-ai/dsh-host-authentication-desktop": "0.2.2-rc.3",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-schedule": "0.2.2-rc.3",
    "@deepseek-ai/dsh-deepseek-account": "0.2.2-rc.3",
